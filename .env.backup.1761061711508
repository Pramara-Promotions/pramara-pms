# --- Database ---
DATABASE_URL="postgresql://pramara:pramara@localhost:5432/pramara?schema=public"

# --- Server ---
PORT=4000
APP_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# --- JWT / Tokens ---
# Use ONE strong secret (64+ random chars). Remove duplicates.
JWT_SECRET="change_this_to_a_long_random_64+_char_string"
REFRESH_SECRET="change_this_to_another_long_random_64+_char_string"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="14"

# --- Cookies (session) ---
SESSION_COOKIE_NAME="pramara.sid"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false       # true only behind https
COOKIE_SAME_SITE="Lax"      # 'None' only if you’re on https with Secure

# --- MFA ---
MFA_ISSUER="Pramara PMS"

# --- Object storage (MinIO via S3-compatible SDK) ---
STORAGE_DRIVER=s3
S3_REGION="us-east-1"
S3_BUCKET="pramara"
S3_ACCESS_KEY_ID="pramara"
S3_SECRET_ACCESS_KEY="pramara123"
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE="http://localhost:9000/pramara"

# (Used directly by lib/storage.js too)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=pramara
MINIO_ACCESS_KEY=pramara
MINIO_SECRET_KEY=pramara123
MINIO_USE_SSL=false

# --- Upload limits ---
MAX_UPLOAD_BYTES=20971520