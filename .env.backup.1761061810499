# Multi-Device Network Development Configuration
# Copy to .env and replace 192.168.1.26 with your actual IP address
# Run: node scripts/get-network-ip.js to find your IP

# REPLACE THIS: Get your IP with 'ipconfig' (Windows) or 'ifconfig' (Mac/Linux)
# Example: 192.168.1.100, 192.168.0.150, 10.0.0.5, etc.
# 192.168.1.26=192.168.1.100

DATABASE_URL="postgresql://pramara:pramara@localhost:5432/pramara?schema=public"
PORT=4000

# Replace 192.168.1.26 with your actual network IP
APP_URL="http://192.168.1.26:4000"

# Allow both network IP and localhost for CORS (separated by comma)
CORS_ORIGIN="http://192.168.1.26:5173,http://localhost:5173"

NODE_ENV=development

JWT_SECRET="change_this_to_a_long_random_64+_char_string"
REFRESH_SECRET="change_this_to_another_long_random_64+_char_string"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="14"

SESSION_COOKIE_NAME="pramara.sid"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false
COOKIE_SAME_SITE="Lax"

MFA_ISSUER="Pramara PMS"

STORAGE_DRIVER=s3
S3_REGION="us-east-1"
S3_BUCKET="pramara"
S3_ACCESS_KEY_ID="pramara"
S3_SECRET_ACCESS_KEY="pramara123"

# Replace 192.168.1.26 with your actual network IP
S3_ENDPOINT="http://192.168.1.26:9000"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE="http://192.168.1.26:9000/pramara"

# Replace 192.168.1.26 with your actual network IP (no http://)
MINIO_ENDPOINT=192.168.1.26
MINIO_PORT=9000
MINIO_BUCKET=pramara
MINIO_ACCESS_KEY=pramara
MINIO_SECRET_KEY=pramara123
MINIO_USE_SSL=false

MAX_UPLOAD_BYTES=20971520
