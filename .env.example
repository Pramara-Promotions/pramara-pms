# ====================================================================
# PRAMARA PMS - ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env and configure for your environment.
# For multi-device development, see docs/MULTI_DEVICE_SETUP.md
# ====================================================================

# --- Database ---
# Use localhost for local dev, or network IP for multi-device access
DATABASE_URL="postgresql://pramara:pramara@localhost:5432/pramara?schema=public"

# --- Server ---
PORT=4000

# APP_URL: The URL where your API server is accessible
# For local dev: http://localhost:4000
# For network dev: http://YOUR_NETWORK_IP:4000 (e.g., http://192.168.1.100:4000)
APP_URL="http://localhost:4000"

# CORS_ORIGIN: Comma-separated list of allowed frontend origins
# For local dev: http://localhost:5173
# For network dev: http://YOUR_NETWORK_IP:5173,http://localhost:5173
# Example: "http://192.168.1.100:5173,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development

# --- JWT / Tokens ---
# IMPORTANT: Generate strong random secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_this_to_a_long_random_64+_char_string"
REFRESH_SECRET="change_this_to_another_long_random_64+_char_string"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="14"

# --- Cookies (session) ---
SESSION_COOKIE_NAME="pramara.sid"

# COOKIE_DOMAIN: Set to your network IP or leave as localhost
# For local dev: localhost
# For network dev: YOUR_NETWORK_IP (e.g., 192.168.1.100) or leave as localhost
COOKIE_DOMAIN="localhost"

# COOKIE_SECURE: Set to true only when using HTTPS
COOKIE_SECURE=false

# COOKIE_SAME_SITE: 'Lax' for local dev, 'None' for HTTPS cross-origin
COOKIE_SAME_SITE="Lax"

# --- MFA ---
MFA_ISSUER="Pramara PMS"

# --- Email (Resend) ---
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_REPLY_TO="support@yourdomain.com"

# --- Object Storage (MinIO via S3-compatible SDK) ---
STORAGE_DRIVER=s3
S3_REGION="us-east-1"
S3_BUCKET="pramara"
S3_ACCESS_KEY_ID="pramara"
S3_SECRET_ACCESS_KEY="pramara123"

# S3_ENDPOINT: MinIO endpoint for API access
# For local dev: http://localhost:9000
# For network dev: http://YOUR_NETWORK_IP:9000
S3_ENDPOINT="http://localhost:9000"

S3_FORCE_PATH_STYLE="true"

# S3_PUBLIC_BASE: Public base URL for MinIO (used for presigned URLs)
# For local dev: http://localhost:9000/pramara
# For network dev: http://YOUR_NETWORK_IP:9000/pramara
S3_PUBLIC_BASE="http://localhost:9000/pramara"

# --- MinIO Direct Config (used by lib/storage.js) ---
# MINIO_ENDPOINT: Hostname/IP only (no protocol)
# For local dev: localhost
# For network dev: YOUR_NETWORK_IP (e.g., 192.168.1.100)
MINIO_ENDPOINT=localhost

MINIO_PORT=9000
MINIO_BUCKET=pramara
MINIO_ACCESS_KEY=pramara
MINIO_SECRET_KEY=pramara123
MINIO_USE_SSL=false

# --- Upload Limits ---
MAX_UPLOAD_BYTES=20971520

# ====================================================================
# NETWORK SETUP EXAMPLE
# ====================================================================
# If your machine's IP is 192.168.1.100, set:
#
# APP_URL="http://192.168.1.100:4000"
# CORS_ORIGIN="http://192.168.1.100:5173,http://localhost:5173"
# S3_ENDPOINT="http://192.168.1.100:9000"
# S3_PUBLIC_BASE="http://192.168.1.100:9000/pramara"
# MINIO_ENDPOINT=192.168.1.100
#
# Then on your second device, use http://192.168.1.100:5173 to access the app.
# ====================================================================
