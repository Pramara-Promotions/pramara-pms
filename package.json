{
  "name": "pramara-pms",
  "version": "1.0.0",
  "description": "Pramara Project Management System — unified backend and frontend setup",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --skip-generate --skip-seed",
    "api:dev": "cd api && npm run dev",
    "api:start": "cd api && npm start",
    "web:dev": "cd web && npm run dev",
    "web:dev:network": "cd web && npm run dev -- --host",
    "web:build": "cd web && npm run build",
    "web:preview": "cd web && npm run preview",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "dev:network": "concurrently \"npm run api:dev\" \"npm run web:dev:network\"",
    "start": "npm run api:start",
    "setup:local": "node scripts/setup-env.js local",
    "setup:network": "node scripts/setup-env.js network",
    "network:ip": "node scripts/get-network-ip.js",
    "neon:test": "node scripts/test-neon-connection.js",
    "storage:migrate": "node scripts/migrate-minio-to-s3.js",
    "chat:save": "node scripts/save-chat-context.js",
    "chat:load": "node scripts/load-chat-context.js",
    "sync:push": "node scripts/sync-push.js",
    "sync:pull": "node scripts/sync-pull.js",
    "test:api": "cd api && npm test",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:integration": "cd api && npm run test:integration",
    "test:performance": "cd api && npm run test:performance",
    "test:all": "npm run test:api && npm run test:e2e && npm run test:integration",
    "test:report": "npx playwright show-report",
    "test:debug": "npx playwright test --debug"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prisma": "^5.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Pramara",
  "license": "MIT"
}
