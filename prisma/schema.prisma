// prisma/schema.prisma
// ====================================================================
// [LANDMARK A] GENERATOR & DATASOURCE
// ====================================================================
generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// [LANDMARK B] AUTH & SECURITY MODELS
// ====================================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  mfaSecret    String?
  mfaEnforcedAt DateTime?
  isActive     Boolean  @default(true)
  status       String   @default("PENDING") // PENDING, ACTIVE, INACTIVE, SUSPENDED
  departmentId String?
  trustDeviceDuration Int @default(30) // days
  auditRetentionDays Int @default(90) // days - minimum 15
  
  // Email Permission Controls (Training Mode Safety)
  emailOutboundEnabled Boolean @default(false) // New users cannot send emails by default
  emailInboundEnabled  Boolean @default(false) // New users cannot process incoming emails
  emailOverrideSystem  Boolean @default(false) // Can send even if system-wide disabled
  emailTrainingMode    Boolean @default(false) // User-specific training mode (dummy emails only)
  
  // Password Reset Security Fields
  mustChangePassword Boolean @default(false) // Force password change on next login
  passwordResetAt    DateTime? // When password was last reset by admin
  passwordResetMethod String? // 'email' or 'manual' - tracking for audit
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department  Department? @relation(fields: [departmentId], references: [id])
  roles       UserRole[]
  sessions    Session[]
  devices     Device[]
  auditEvents AuditLog[] @relation("AuditByUser")
  temporaryPermissions TemporaryPermission[]
  permissionRequests PermissionRequest[]
  notifications Notification[]

  // Invites
  inviteToken   String?   @unique
  inviteExpires DateTime?
  createdById   String?   // Who invited this user
  createdBy     User?     @relation("UserInvitedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invitedUsers  User[]    @relation("UserInvitedBy")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  status      String           @default("ACTIVE") // ACTIVE, PENDING_APPROVAL
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
  approvals   RoleApproval[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  // back-relation for RolePermission
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ip               String?
  deviceId         String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  ip          String?
  userAgent   String?
  trusted     Boolean   @default(false)
  trustUntil  DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
  auditLogs AuditLog[]

  @@unique([userId, fingerprint])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  deviceId  String?
  changes   Json?
  result    String?  // SUCCESS, FAILURE
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  actor  User?   @relation("AuditByUser", fields: [actorId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([flagged])
  @@index([createdAt])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([name])
}

model TemporaryPermission {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  startDate      DateTime  @default(now())
  endDate        DateTime
  grantedBy      String
  reason         String?
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model PermissionRequest {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  reason         String
  duration       Int?      // days, null = permanent
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt    DateTime  @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  response       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RoleApproval {
  id         String    @id @default(cuid())
  roleId     String
  createdBy  String
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  feedback   String?
  createdAt  DateTime  @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'cutoff_warning', 'qc_failure', 'daily_plan_ready', etc.
  priority  String   @default("medium") // 'low', 'medium', 'high', 'critical'
  
  // CONTEXT (what, where, who)
  title     String
  message   String
  entityType String? // 'project', 'task', 'batch', 'station', 'document', etc.
  entityId   String?
  entityName String? // Display name: "ABC Toy Set"
  entityCode String? // Business code: "PO-2025-123"
  
  // WHO & WHERE
  assignedTo String? // Person responsible
  location   String? // "Station 3, Room B"
  
  // ACTIONS (guidance for user)
  primaryAction     String? // Label: "View Station"
  primaryActionUrl  String? // URL or route: "/stations/123"
  primaryActionType String? // 'navigate', 'modal', 'external', 'action'
  secondaryActions  Json?   // Array: [{label, url, type}, ...]
  
  // IMPACT (why it matters)
  impactLevel   String? // Human-readable: "Delays cutoff by 2 hours"
  impactDetails Json?   // Structured data: {cutoffIn, ragStatus, affectedProjects}
  
  // STATE
  read       Boolean  @default(false)
  readAt     DateTime?
  dismissed  Boolean  @default(false)
  dismissedAt DateTime?
  expiresAt  DateTime? // Auto-dismiss after date
  
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, dismissed])
  @@index([createdAt])
  @@index([type])
  @@index([priority])
  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ====================================================================
// [LANDMARK B.5] EMAIL SYSTEM
// ====================================================================

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  htmlBody    String   @db.Text
  textBody    String?  @db.Text
  variables   String[] // e.g., ['userName', 'projectName', 'actionUrl']
  category    String   // 'auth', 'notification', 'compliance', etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id              String   @id @default(cuid())
  to              String
  cc              String[]
  bcc             String[]
  from            String
  replyTo         String?
  subject         String
  htmlBody        String?  @db.Text
  textBody        String?  @db.Text
  
  // Template used (if any)
  templateId      String?
  templateData    Json?
  
  // Delivery tracking
  status          String   // 'sent', 'dummy_training_mode', 'failed', 'blocked_user_disabled', 'blocked_system_disabled'
  provider        String   @default("resend")
  providerMsgId   String?  // External tracking ID from Resend
  sentAt          DateTime?
  error           String?
  
  // Analytics tracking (Phase 7)
  opened          Boolean  @default(false)
  openedAt        DateTime?
  openCount       Int      @default(0)
  clicked         Boolean  @default(false)
  clickedAt       DateTime?
  clickCount      Int      @default(0)
  bounced         Boolean  @default(false)
  bouncedAt       DateTime?
  bounceReason    String?
  
  // Metadata
  userId          String?  // Who triggered this email
  notificationId  String?  // Link to notification if triggered by one
  
  createdAt       DateTime @default(now())
  
  @@index([status, createdAt])
  @@index([userId])
  @@index([opened])
  @@index([clicked])
}

model InboundEmail {
  id              String   @id @default(cuid())
  
  // Email Headers
  messageId       String   @unique // Email Message-ID header
  from            String
  to              String[]
  cc              String[]
  subject         String
  
  // Content
  textBody        String?  @db.Text
  htmlBody        String?  @db.Text
  
  // Attachments
  hasAttachments  Boolean  @default(false)
  attachmentCount Int      @default(0)
  attachments     Json?    // [{filename, size, mimeType, key}]
  
  // Classification
  classified      Boolean  @default(false)
  classification  String?  // 'invoice', 'po', 'spec', 'artwork', 'general', etc.
  confidence      Float?   // 0-1 classification confidence
  
  // Entity Association
  linkedEntity    String?  // 'project', 'document', 'batch', etc.
  linkedEntityId  String?
  linkedBy        String?  // User ID who linked
  linkedAt        DateTime?
  
  // Processing Status
  status          String   @default("unread") // 'unread', 'read', 'processed', 'archived', 'deleted'
  processed       Boolean  @default(false)
  processedBy     String?  // User ID
  processedAt     DateTime?
  
  // Metadata
  receivedAt      DateTime @default(now())
  rawHeaders      Json?
  inReplyTo       String?  // Thread tracking
  references      String[] // Email thread references
  
  createdAt       DateTime @default(now())
  
  @@index([status, receivedAt])
  @@index([from])
  @@index([linkedEntity, linkedEntityId])
  @@index([classification])
}

// ====================================================================
// [LANDMARK C] PROJECT & EXECUTION MODELS
// ====================================================================

// Email account configuration for inbound processing (UI-managed)
model EmailAccount {
  id           String   @id @default(cuid())
  label        String
  provider     String   @default("exchange") // 'exchange', 'generic'
  protocol     String   @default("imap")     // 'imap', 'graph'
  authMethod   String   @default("basic")    // 'basic', 'oauth2', 'client_credentials'

  // IMAP/basic fields
  username     String
  passwordEnc  String?  // encrypted at rest (AES-GCM)
  host         String?
  port         Int?     @default(993)
  tls          Boolean? @default(true)

  // OAuth/Graph fields
  tenantId     String?
  clientId     String?
  clientSecretEnc String?
  refreshTokenEnc  String?
  mailbox      String? // mailbox email for Graph or delegated account

  enabled      Boolean  @default(true)
  status       String?  // 'connected', 'error:<msg>' etc. (best-effort)
  lastSyncAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
  @@index([protocol, authMethod])
}

// ====================================================================
// [LANDMARK B.6] DOCUMENT INTELLIGENCE
// ====================================================================

model DocumentExtractionJob {
  id             String   @id @default(cuid())
  entity         String
  entityId       String?
  filename       String
  mimeType       String?
  fileKey        String?
  filePath       String?
  fileSize       Int      @default(0)
  sourceType     String   @default("upload") // 'upload' | 'email'
  sourceId       String?
  meta           Json?
  processingMode String   @default("immediate") // immediate | delayed | background | rejected
  status         String   @default("queued")     // queued | processing | completed | failed
  methodSummary  String?
  confidenceAvg  Int?
  error          String?
  startedAt      DateTime? @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  // Approval workflow
  approvedFields Json?
  approvedBy     String?
  approvedAt     DateTime?
  appliedAt      DateTime?
  appliedBy      String?
  applicationError String?

  fields DocumentExtractionField[]
  approvals DocumentExtractionApproval[]

  @@index([entity, entityId])
  @@index([status, createdAt])
}

model DocumentExtractionField {
  id                String   @id @default(cuid())
  jobId             String
  name              String
  value             String?
  confidence        Int?
  method            String?
  sourcePage        Int?
  sourceFile        String?
  sourceCoordinates Json?
  unit              String?
  structured        Json?

  job DocumentExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, name])
}

model DocumentExtractionApproval {
  id             String   @id @default(cuid())
  jobId          String
  approvedFields Json
  approvedBy     String?
  approvedAt     DateTime @default(now())
  applied        Boolean  @default(false)
  appliedAt      DateTime?

  job DocumentExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
model Project {
  id          Int       @id @default(autoincrement())
  code        String
  name        String
  sku         String?
  quantity    Int
  cutoffDate  DateTime?
  pantoneCode String?
  createdAt   DateTime  @default(now())

  // Relations
  complianceItems ComplianceItem[]
  changes         ChangeLog[]
  documents       ProjectDocument[]
  skus            ProjectSku[]
  qcRecords       QCRecord[]
  alerts          Alert[]
  alertRules      AlertRule[]
  inventoryNeeds  InventoryNeed[]
  preProdSteps    PreProdStep[]
  variances       VarianceItem[]

  stations        Station[]

  pref           ProjectPref?
  purchaseOrders PurchaseOrder[]
}

// [LMK: PRISMA — CASCADE CHILDREN WHEN PROJECT DELETES]
// (Prisma does NOT support /* */ comments; use // only.)

model ProjectPref {
  id          Int     @id @default(autoincrement())
  projectId   Int     @unique
  skuAttrKeys Json?
  lastPo      String?
  // [LMK] cascade when a project is deleted
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  projectId  Int
  poNumber   String
  fileKey    String
  createdAt  DateTime @default(now())
  // [LMK] cascade when a project is deleted
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, poNumber])
  @@index([projectId])
}

model ProjectSku {
  id         Int      @id @default(autoincrement())
  projectId  Int
  poNumber   String?
  code       String
  name       String?
  color      String?
  type       String?
  orderQty   Int?
  attributes Json?
  // [LMK] cascade when a project is deleted
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, code])
}

model ComplianceItem {
  id          Int       @id @default(autoincrement())
  projectId   Int
  type        String
  status      String    @default("PLANNED")
  owner       String?
  labName     String?
  dueDate     DateTime?
  requestedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  documentUrl String?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([type])
}

model ChangeLog {
  id          Int               @id @default(autoincrement())
  projectId   Int
  type        String
  description String?
  requestedBy String
  requestedAt DateTime          @default(now())
  impact      Json?
  documents   ProjectDocument[]

  approvalRequired Boolean   @default(true)
  approver         String?
  approvedBy       String?
  approvalStatus   String    @default("PENDING")
  approvalProof    String?
  approvalDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approvalStatus])
  @@index([type])
}

model ProjectDocument {
  id                Int       @id @default(autoincrement())
  projectId         Int
  kind              String
  title             String
  url               String?
  referenceUrl      String?
  key               String?
  storageKey        String?
  contentType       String?
  version           Int       @default(1)
  active            Boolean   @default(false)
  tags              Json?
  notes             String?
  uploadedBy        String?
  uploadedAt        DateTime  @default(now())
  approvedBy        String?
  approverRole      String?
  approvedAt        DateTime?
  approvalProof     String?
  verifiedBy        String?
  verifierRole      String?
  verifiedAt        DateTime?
  verificationProof String?
  affectedTeams     Json?
  isStandard        Boolean   @default(false)
  sourceChangeId    Int?
  approvalEmails    Json?
  notificationEmails Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Versioning
  parentId          Int?
  parent            ProjectDocument? @relation("DocumentParent", fields: [parentId], references: [id])
  revisions         ProjectDocument[] @relation("DocumentParent")
  revisionNote      String?

  // Tagging to stations
  documentStations  DocumentStation[]

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeLog ChangeLog?     @relation(fields: [sourceChangeId], references: [id])
  variances VarianceItem[] @relation("VarianceDocument")

  @@index([projectId, kind, title])
  @@index([parentId])
}

// Station model (if not already present)
model Station {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  // ... add more fields as needed
  documents DocumentStation[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Join table for many-to-many between ProjectDocument and Station
model DocumentStation {
  id           Int             @id @default(autoincrement())
  documentId   Int
  stationId    Int
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  station      Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([documentId, stationId])
}

model VarianceItem {
  id          Int       @id @default(autoincrement())
  projectId   Int
  category    String
  field       String
  expected    String
  actual      String
  sourceDocId Int?
  remarks     String?
  status      String    @default("DEVIATION")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  ProjectDocument? @relation("VarianceDocument", fields: [sourceDocId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model QCRecord {
  id           Int      @id @default(autoincrement())
  projectId    Int
  batchCode    String?
  passed       Int      @default(0)
  rejected     Int      @default(0)
  reason       String?
  pantoneMatch String?  @default("Match")
  createdAt    DateTime @default(now())

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model InventoryNeed {
  id           Int      @id @default(autoincrement())
  projectId    Int
  material     String
  requiredQty  Int
  availableQty Int
  shortfall    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AlertRule {
  id         Int      @id @default(autoincrement())
  projectId  Int
  key        String
  level      String
  threshold  Int      @default(0)
  recipients String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, key])
}

model Alert {
  id        Int      @id @default(autoincrement())
  projectId Int
  level     String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions AlertAction[]

  @@index([projectId])
  @@index([status])
}

model AlertAction {
  id                Int      @id @default(autoincrement())
  alertId           Int
  action            String
  by                String?
  note              String?
  correctiveActions String?
  preventRecurrence String?
  costImpactCents   Int?
  costNote          String?
  createdAt         DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model PreProdStep {
  id        Int       @id @default(autoincrement())
  projectId Int
  step      String
  status    String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
