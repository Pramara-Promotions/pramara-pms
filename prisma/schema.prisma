generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  mfaSecret            String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inviteToken          String?               @unique
  inviteExpires        DateTime?
  departmentId         String?
  mfaEnforcedAt        DateTime?
  name                 String?
  status               String                @default("PENDING")
  trustDeviceDuration  Int                   @default(30)
  mustChangePassword   Boolean               @default(false)
  passwordResetAt      DateTime?
  passwordResetMethod  String?
  auditRetentionDays   Int                   @default(90)
  emailInboundEnabled  Boolean               @default(false)
  emailOutboundEnabled Boolean               @default(false)
  emailOverrideSystem  Boolean               @default(false)
  emailTrainingMode    Boolean               @default(false)
  emailDigestEnabled   Boolean               @default(true)
  emailDigestFrequency String                @default("daily")
  emailVerified        Boolean               @default(false)
  firstName            String?
  lastName             String?
  timeZone             String?
  createdById          String?
  auditEvents          AuditLog[]            @relation("AuditByUser")
  devices              Device[]
  notifications        Notification[]
  permissionRequests   PermissionRequest[]
  sessions             Session[]
  temporaryPermissions TemporaryPermission[]
  User                 User?                 @relation("UserToUser", fields: [createdById], references: [id])
  other_User           User[]                @relation("UserToUser")
  department           Department?           @relation(fields: [departmentId], references: [id])
  roles                UserRole[]

  // Pre-Production Workflow Relations
  moldsCreated       Mold[]            @relation("MoldCreator")
  trialsRun          Trial[]           @relation("TrialRunner")
  trialsApproved     Trial[]           @relation("TrialApprover")
  packagingSubmitted PackagingDesign[] @relation("PackagingSubmitter")
  packagingReviewed  PackagingDesign[] @relation("PackagingReviewer")
  packagingApproved  PackagingDesign[] @relation("PackagingApprover")
  ppsSubmitted       PPSApproval[]     @relation("PPSSubmitter")
  ppsApproved        PPSApproval[]     @relation("PPSApprover")
  ppsRejected        PPSApproval[]     @relation("PPSRejector")

  // Compliance Relations
  companyCerts               CompanyCertification[]  @relation("CompanyCertificationResponsible")
  projectCompliance          ProjectCompliance[]     @relation("ProjectComplianceResponsible")
  requirementsAssigned       ComplianceRequirement[] @relation("RequirementAssignee")
  requirementsCompleted      ComplianceRequirement[] @relation("RequirementCompleter")
  documentsUploaded          ComplianceDocument[]    @relation("DocumentUploader")
  documentsVerified          ComplianceDocument[]    @relation("DocumentVerifier")
  labTestsCreated            LabTest[]               @relation("LabTestCreator")
  materialComplianceCreated  MaterialCompliance[]    @relation("MaterialComplianceCreator")
  materialComplianceVerified MaterialCompliance[]    @relation("MaterialComplianceVerifier")
  remindersAssigned          ComplianceReminder[]    @relation("ReminderAssignee")
  remindersAcknowledged      ComplianceReminder[]    @relation("ReminderAcknowledger")

  // Project Policy Relations
  policiesResponsible ProjectPolicy[] @relation("PolicyResponsible")
  policiesCreated     ProjectPolicy[] @relation("PolicyCreator")

  // Process Flow Relations
  processFlowsCreated ProcessFlow[] @relation("ProcessFlowCreator")

  // Shift Entry Relations
  shiftsSupervised ShiftEntry[] @relation("ShiftSupervisor")
  shiftsApproved   ShiftEntry[] @relation("ShiftApprover")
  shiftsCreated    ShiftEntry[] @relation("ShiftCreator")

  // WIP Ledger Relations
  wipOperations    WIPLedger[] @relation("WIPOperator")
  wipCancellations WIPLedger[] @relation("WIPCanceller")
  wipCreated       WIPLedger[] @relation("WIPCreator")

  // Reminder Relations
  assignedReminders Reminder[] @relation("AssignedReminders")
  createdReminders  Reminder[] @relation("CreatedReminders")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime         @default(now())
  createdBy   String?
  status      String           @default("ACTIVE")
  approvals   RoleApproval[]
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  deviceId         String?
  device           Device?  @relation(fields: [deviceId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model Device {
  id          String     @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  ip          String?
  userAgent   String?
  trusted     Boolean    @default(false)
  trustUntil  DateTime?
  lastUsedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  auditLogs   AuditLog[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([userId, fingerprint])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  changes   Json?
  deviceId  String?
  flagged   Boolean  @default(false)
  result    String?
  actor     User?    @relation("AuditByUser", fields: [actorId], references: [id])
  device    Device?  @relation(fields: [deviceId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([flagged])
  @@index([createdAt])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([name])
}

model TemporaryPermission {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  startDate      DateTime  @default(now())
  endDate        DateTime
  grantedBy      String
  reason         String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model PermissionRequest {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  reason         String
  duration       Int?
  status         String    @default("PENDING")
  requestedAt    DateTime  @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  response       String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RoleApproval {
  id         String    @id @default(cuid())
  roleId     String
  createdBy  String
  status     String    @default("PENDING")
  reviewedBy String?
  reviewedAt DateTime?
  feedback   String?
  createdAt  DateTime  @default(now())
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              String
  title             String
  message           String
  read              Boolean   @default(false)
  createdAt         DateTime  @default(now())
  assignedTo        String?
  dismissed         Boolean   @default(false)
  dismissedAt       DateTime?
  entityCode        String?
  entityId          String?
  entityName        String?
  entityType        String?
  expiresAt         DateTime?
  impactDetails     Json?
  impactLevel       String?
  location          String?
  primaryAction     String?
  primaryActionType String?
  primaryActionUrl  String?
  priority          String    @default("medium")
  readAt            DateTime?
  secondaryActions  Json?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([priority])
  @@index([expiresAt])
  @@index([type])
  @@index([userId, dismissed])
  @@index([entityType, entityId])
}

model UserPreferences {
  id          String   @id @default(cuid())
  userId      String   @unique
  pinnedItems Json     @default("[]")
  homeLayout  Json?
  theme       String   @default("light")
  notifications Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Project {
  id                    Int                     @id @default(autoincrement())
  code                  String
  name                  String
  sku                   String?
  quantity              Int
  cutoffDate            DateTime?
  pantoneCode           String?
  createdAt             DateTime                @default(now())
  alerts                Alert[]
  alertRules            AlertRule[]
  ApprovalRequest       ApprovalRequest[]
  Batch                 Batch[]
  Lots                  Lot[]
  BoardColumn           BoardColumn[]
  changes               ChangeLog[]
  complianceItems       ComplianceItem[]
  DailyPlan             DailyPlan[]
  DailyPlanStation      DailyPlanStation[]
  inventoryNeeds        InventoryNeed[]
  MaterialConsumption   MaterialConsumption[]
  preProdSteps          PreProdStep[]
  ProcessConfig         ProcessConfig[]
  ProductionCalculation ProductionCalculation[]
  ProductionEntry       ProductionEntry[]
  documents             ProjectDocument[]
  pref                  ProjectPref?
  skus                  ProjectSku[]
  purchaseOrders        PurchaseOrder[]
  QCChecklistTemplate   QCChecklistTemplate[]
  qcRecords             QCRecord[]
  QCSubmission          QCSubmission[]
  ShiftHandover         ShiftHandover[]
  stations              Station[]
  Task                  Task[]
  variances             VarianceItem[]
  WorkerPerformance     WorkerPerformance[]
  WorkflowStage         WorkflowStage[]

  // Pre-Production Workflow Relations
  molds            Mold[]
  trials           Trial[]
  packagingDesigns PackagingDesign[]
  ppsApprovals     PPSApproval[]

  // Compliance Relations
  projectCompliance   ProjectCompliance[]
  labTests            LabTest[]
  materialCompliance  MaterialCompliance[]
  complianceReminders ComplianceReminder[]

  // Project Policy Relations
  policies ProjectPolicy[]

  // Process Flow Relations
  processFlows ProcessFlow[]

  // Shift Entry Relations
  shiftEntries ShiftEntry[]

  // WIP Ledger Relations
  wipLedgers WIPLedger[]

  // MRP Relations
  materialRequirements MaterialRequirement[]
  mrpLearning          MRPLearning[]
  mrpRecommendations   MRPRecommendation[]
}

model ProjectPref {
  id          Int     @id @default(autoincrement())
  projectId   Int     @unique
  skuAttrKeys Json?
  lastPo      String?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id        Int      @id @default(autoincrement())
  projectId Int
  poNumber  String
  fileKey   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, poNumber])
  @@index([projectId])
}

model ProjectSku {
  id                  Int                   @id @default(autoincrement())
  projectId           Int
  code                String
  attributes          Json?
  color               String?
  name                String?
  orderQty            Int?
  poNumber            String?
  type                String?
  Batch               Batch[]
  DailyPlanStation    DailyPlanStation[]
  ProcessConfig       ProcessConfig[]
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  QCChecklistTemplate QCChecklistTemplate[]
  QCSubmission        QCSubmission[]

  // MRP Relations
  materialRequirements MaterialRequirement[]
  bomItems             BOMItem[]
  mrpLearning          MRPLearning[]
  mrpRecommendations   MRPRecommendation[]

  @@unique([projectId, code])
  @@index([projectId])
}

model ComplianceItem {
  id          Int       @id @default(autoincrement())
  projectId   Int
  type        String
  status      String    @default("PLANNED")
  owner       String?
  labName     String?
  dueDate     DateTime?
  requestedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  documentUrl String?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([type])
}

model ChangeLog {
  id               Int               @id @default(autoincrement())
  projectId        Int
  type             String
  description      String?
  requestedBy      String
  requestedAt      DateTime          @default(now())
  impact           Json?
  approvalRequired Boolean           @default(true)
  approver         String?
  approvedBy       String?
  approvalStatus   String            @default("PENDING")
  approvalProof    String?
  approvalDate     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents        ProjectDocument[]

  @@index([projectId])
  @@index([approvalStatus])
  @@index([type])
}

model ProjectDocument {
  id                 Int               @id @default(autoincrement())
  projectId          Int
  url                String?
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  approvalProof      String?
  contentType        String?
  storageKey         String?
  active             Boolean           @default(false)
  affectedTeams      Json?
  approvedAt         DateTime?
  approvedBy         String?
  approverRole       String?
  isStandard         Boolean           @default(false)
  kind               String
  notes              String?
  sourceChangeId     Int?
  tags               Json?
  title              String
  updatedAt          DateTime          @updatedAt
  uploadedAt         DateTime          @default(now())
  uploadedBy         String?
  verificationProof  String?
  verifiedAt         DateTime?
  verifiedBy         String?
  verifierRole       String?
  key                String?
  approvalEmails     Json?
  notificationEmails Json?
  referenceUrl       String?
  parentId           Int?
  revisionNote       String?
  documentStations   DocumentStation[]
  parent             ProjectDocument?  @relation("DocumentParent", fields: [parentId], references: [id])
  revisions          ProjectDocument[] @relation("DocumentParent")
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeLog          ChangeLog?        @relation(fields: [sourceChangeId], references: [id])
  variances          VarianceItem[]    @relation("VarianceDocument")

  @@index([projectId, kind, title])
  @@index([parentId])
}

model Station {
  id                 Int      @id @default(autoincrement())
  projectId          Int?
  name               String
  active             Boolean  @default(true)
  avgOutputRate      Float?
  avgQualityRate     Float?
  capacity           Int?     @default(1)
  code               String?  @unique
  createdAt          DateTime @default(now())
  description        String?
  roomId             Int?
  stationTypeId      Int?
  status             String   @default("operational")
  totalJobsCompleted Int      @default(0)
  updatedAt          DateTime

  // Workstation Type & Configuration
  workstationType String? // 'machine', 'manual', 'hybrid'
  isMultiAsset    Boolean @default(false) // Can this workstation use multiple assets?

  // Capacity & Performance Metrics
  baseCycleTime     Float? // Base cycle time in minutes
  actualCycleTime   Float? // Current actual cycle time
  cycleTimeUnit     String? // 'minutes', 'hours', 'pieces_per_hour'
  targetUtilization Float? // Target utilization percentage
  actualUtilization Float? // Actual utilization percentage

  // Asset Configuration
  requiresAssets     Boolean  @default(false) // Does this workstation require assets to operate?
  requiredAssetTypes String[] // Array of required asset types

  // Cross-SKU Balance Tracking
  currentSKU      String? // Current SKU being processed
  skuCycleTimeMap Json? // Map of SKU codes to their cycle times

  // Learning & Optimization
  learningEnabled     Boolean @default(true) // Enable ML for this workstation
  performanceBaseline Json? // Baseline performance metrics

  Batch                                              Batch[]
  BatchMovement_BatchMovement_fromStationIdToStation BatchMovement[]         @relation("BatchMovement_fromStationIdToStation")
  BatchMovement_BatchMovement_toStationIdToStation   BatchMovement[]         @relation("BatchMovement_toStationIdToStation")
  DailyPlanStation                                   DailyPlanStation[]
  documents                                          DocumentStation[]
  MaintenanceLog                                     MaintenanceLog[]
  MaterialConsumption                                MaterialConsumption[]
  ProcessConfig                                      ProcessConfig[]
  ProductionCalculation                              ProductionCalculation[]
  ProductionEntry                                    ProductionEntry[]
  QCChecklistTemplate                                QCChecklistTemplate[]
  QCSubmission                                       QCSubmission[]
  ShiftPlan                                          ShiftPlan[]
  project                                            Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Room                                               Room?                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  StationType                                        StationType?            @relation(fields: [stationTypeId], references: [id])
  WorkerPerformance                                  WorkerPerformance[]
  processOperations                                  ProcessOperation[]
  shiftEntries                                       ShiftEntry[]
  wipLedgers                                         WIPLedger[]
  wipFromStation                                     WIPLedger[]             @relation("WIPFromStation")
  wipToStation                                       WIPLedger[]             @relation("WIPToStation")

  // Asset Management Relations
  WorkstationAssets WorkstationAsset[] @relation("StationAssets")

  @@index([code])
  @@index([projectId])
  @@index([roomId])
  @@index([stationTypeId])
  @@index([status])
  @@index([workstationType])
}

model DocumentStation {
  id         Int             @id @default(autoincrement())
  documentId Int
  stationId  Int
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  station    Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([documentId, stationId])
}

model VarianceItem {
  id          Int              @id @default(autoincrement())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  actual      String
  category    String
  expected    String
  field       String
  projectId   Int
  remarks     String?
  resolvedAt  DateTime?
  sourceDocId Int?
  status      String           @default("DEVIATION")
  Project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      ProjectDocument? @relation("VarianceDocument", fields: [sourceDocId], references: [id])

  @@index([projectId])
}

model QCRecord {
  id           Int      @id @default(autoincrement())
  projectId    Int
  createdAt    DateTime @default(now())
  batchCode    String?
  pantoneMatch String?  @default("Match")
  passed       Int      @default(0)
  reason       String?
  rejected     Int      @default(0)
  Project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model InventoryNeed {
  id           Int      @id @default(autoincrement())
  projectId    Int
  createdAt    DateTime @default(now())
  availableQty Int
  material     String
  requiredQty  Int
  shortfall    Int      @default(0)
  updatedAt    DateTime @updatedAt
  Project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AlertRule {
  id         Int      @id @default(autoincrement())
  projectId  Int
  createdAt  DateTime @default(now())
  enabled    Boolean  @default(true)
  key        String
  level      String
  recipients String?
  threshold  Int      @default(0)
  updatedAt  DateTime @updatedAt
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, key])
}

model Alert {
  id        Int           @id @default(autoincrement())
  projectId Int
  message   String
  createdAt DateTime      @default(now())
  level     String
  status    String        @default("OPEN")
  updatedAt DateTime      @updatedAt
  Project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions   AlertAction[]

  @@index([projectId])
  @@index([status])
}

model AlertAction {
  id                Int      @id @default(autoincrement())
  alertId           Int
  action            String
  createdAt         DateTime @default(now())
  by                String?
  correctiveActions String?
  costImpactCents   Int?
  costNote          String?
  note              String?
  preventRecurrence String?
  alert             Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model PreProdStep {
  id        Int       @id @default(autoincrement())
  projectId Int
  step      String
  status    String
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  Project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApprovalReminder {
  id                String          @id
  approvalRequestId String
  reminderType      String
  reminderDate      DateTime
  sentAt            DateTime?
  sentTo            String[]
  channel           String
  status            String          @default("pending")
  ApprovalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@index([reminderDate])
  @@index([status])
}

model ApprovalRequest {
  id                  String             @id
  projectId           Int
  workflowStageId     String?
  approvalType        String
  description         String
  requiredFrom        String
  requiredFromContact String?
  requestedBy         String
  requestedAt         DateTime           @default(now())
  expectedDate        DateTime
  cutoffDate          DateTime
  bufferDays          Int
  status              String             @default("pending")
  approvedAt          DateTime?
  approvedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  requestedChanges    String?
  delayedNewDate      DateTime?
  delayReason         String?
  overrideBy          String?
  overrideReason      String?
  overrideRisk        String?
  overrideAt          DateTime?
  attachments         String[]
  ApprovalReminder    ApprovalReminder[]
  Project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  WorkflowStage       WorkflowStage?     @relation(fields: [workflowStageId], references: [id])

  @@index([cutoffDate])
  @@index([projectId])
  @@index([status])
}

model Batch {
  id               String  @id
  batchCode        String  @unique
  projectId        Int
  poNumber         String?
  projectSkuId     Int
  subSkuIdentifier String? // "A", "B", "C" for multi-part assemblies

  // Quantity tracking
  targetQty   Int
  currentQty  Int
  rejectedQty Int @default(0)

  // Weight-based calculation support
  totalWeight     Float?
  containerWeight Float?
  calculatedQty   Int?
  quantityMethod  String @default("count") // "count" or "weight"

  // Hierarchy (sub-batching support)
  parentBatchId      String?
  subBatchIdentifier String? // "T01", "T02" for tray/container identification
  lotId              String? // When packed into shipping lot

  // Status & Location
  currentStationId Int?
  status           String @default("in_progress") // in_progress, completed, rejected, rework

  // Rejection tracking
  isRejection        Boolean @default(false)
  rejectionReason    String?
  rejectionStationId Int?
  reworkRequired     Boolean @default(false)
  reworkCompleted    Boolean @default(false)

  // Assembly linkage (for multi-SKU products)
  assembledFrom    String[] // Array of source batch IDs
  assembledInto    String? // Parent assembled batch ID
  assemblyStation  String?
  assemblyOperator String?
  assemblyDate     DateTime?

  // Traceability
  materialLots Json // [{lotNumber, materialId, qty}]
  machineId    String?

  // Metadata
  createdBy   String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  Station     Station?   @relation(fields: [currentStationId], references: [id])
  Project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ProjectSku  ProjectSku @relation(fields: [projectSkuId], references: [id])
  ParentBatch Batch?     @relation("SubBatches", fields: [parentBatchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  SubBatches  Batch[]    @relation("SubBatches")
  Lot         Lot?       @relation(fields: [lotId], references: [id])

  BatchMovement BatchMovement[]
  QCSubmission  QCSubmission[]
  wipLedgers    WIPLedger[]

  @@index([batchCode])
  @@index([currentStationId])
  @@index([projectId])
  @@index([status])
  @@index([parentBatchId])
  @@index([lotId])
  @@index([isRejection])
}

model BatchMovement {
  id                                           String   @id
  batchId                                      String
  fromStationId                                Int?
  toStationId                                  Int
  qty                                          Int
  operatorId                                   String?
  condition                                    String?
  photos                                       String[]
  notes                                        String?
  timestamp                                    DateTime @default(now())
  Batch                                        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  Station_BatchMovement_fromStationIdToStation Station? @relation("BatchMovement_fromStationIdToStation", fields: [fromStationId], references: [id])
