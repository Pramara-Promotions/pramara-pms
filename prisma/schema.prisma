  estimatedTime      Int?
  isOptional         Boolean          @default(false)
  checkpoints        Json?
  instructions       String?
  imageUrls          Json?
  videoUrl           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  processOperation   ProcessOperation @relation(fields: [processOperationId], references: [id], onDelete: Cascade)

  @@index([processOperationId])
  @@index([sequence])
}

model ProcessTemplate {
  id              String   @id @default(cuid())
  name            String
  processType     String
  subType         String?
  description     String?
  isSystemDefined Boolean  @default(false)
  usageCount      Int      @default(0)
  successRate     Float    @default(0)
  structure       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  creator         User?    @relation("TemplateCreator", fields: [createdBy], references: [id])

  @@index([processType, subType])
  @@index([usageCount])
  @@index([successRate])
}

model ShiftEntry {
  id               String    @id @default(cuid())
  projectId        Int
  stationId        Int?
  shiftDate        DateTime
  shiftType        String
  shiftStartTime   DateTime
  shiftEndTime     DateTime
  supervisorId     String
  workersPresent   Int       @default(0)
  workersAbsent    Int       @default(0)
  totalProduced    Int       @default(0)
  targetProduction Int?
  qualityPassed    Int       @default(0)
  qualityRejected  Int       @default(0)
  downtimeMinutes  Int       @default(0)
  downtimeReason   String?
  machineStatus    Json?
  materialsUsed    Json?
  issues           Json?
  achievements     String?
  handoverNotes    String?
  efficiency       Float?
  status           String    @default("draft")
  approvedBy       String?
  approvedAt       DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approver         User?     @relation("ShiftApprover", fields: [approvedBy], references: [id])
  creator          User      @relation("ShiftCreator", fields: [createdBy], references: [id])
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  station          Station?  @relation(fields: [stationId], references: [id])
  supervisor       User      @relation("ShiftSupervisor", fields: [supervisorId], references: [id])

  @@index([projectId])
  @@index([stationId])
  @@index([shiftDate])
  @@index([supervisorId])
  @@index([status])
}

model WIPLedger {
  id              String    @id @default(cuid())
  projectId       Int
  stationId       Int?
  batchId         String?
  transactionDate DateTime  @default(now())
  transactionType String
  itemCode        String
  itemDescription String
  quantity        Float
  unit            String    @default("pcs")
  fromLocation    String?
  toLocation      String?
  fromStationId   Int?
  toStationId     Int?
  referenceType   String?
  referenceId     String?
  operationCode   String?
  operatorId      String?
  qualityStatus   String?
  remarks         String?
  costPerUnit     Float?
  totalCost       Float?
  balanceQuantity Float?
  status          String    @default("active")
  cancelledBy     String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  batch           Batch?    @relation(fields: [batchId], references: [id])
  canceller       User?     @relation("WIPCanceller", fields: [cancelledBy], references: [id])
  creator         User      @relation("WIPCreator", fields: [createdBy], references: [id])
  fromStation     Station?  @relation("WIPFromStation", fields: [fromStationId], references: [id])
  operator        User?     @relation("WIPOperator", fields: [operatorId], references: [id])
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  station         Station?  @relation(fields: [stationId], references: [id])
  toStation       Station?  @relation("WIPToStation", fields: [toStationId], references: [id])

  @@index([projectId])
  @@index([stationId])
  @@index([batchId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([itemCode])
  @@index([status])
}

model CostTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String
  defaultValue Float?
  unit         String?
  customizable Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model ProjectCosting {
  id            String            @id @default(cuid())
  projectId     Int
  version       Int               @default(1)
  status        String            @default("draft")
  exFactoryCost Float?
  fobCost       Float?
  sellingPrice  Float?
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  components    CostComponent[]
  approvals     CostingApproval[]
  pricingTiers  PricingTier[]
  Project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model CostComponent {
  id               String         @id @default(cuid())
  projectCostingId String
  category         String
  name             String
  unit             String?
  allocation       String         @default("per_unit")
  quantity         Float?
  costPerUnit      Float?
  totalCost        Float?
  oneTime          Boolean        @default(false)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ProjectCosting   ProjectCosting @relation(fields: [projectCostingId], references: [id], onDelete: Cascade)

  @@index([projectCostingId])
  @@index([category])
}

model PricingTier {
  id               String         @id @default(cuid())
  projectCostingId String
  minQty           Int
  pricePerUnit     Float
  currency         String         @default("USD")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ProjectCosting   ProjectCosting @relation(fields: [projectCostingId], references: [id], onDelete: Cascade)

  @@index([projectCostingId])
}

model MarginRule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  criteria      Json?
  marginPercent Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

model CostingApproval {
  id               String         @id @default(cuid())
  projectCostingId String
  status           String         @default("pending")
  approverId       String?
  comments         String?
  actedAt          DateTime?
  ProjectCosting   ProjectCosting @relation(fields: [projectCostingId], references: [id], onDelete: Cascade)

  @@index([projectCostingId])
  @@index([status])
}

model ProductComponent {
  id           String              @id @default(cuid())
  projectId    Int
  skuId        Int?
  name         String
  type         String
  material     String?
  color        String?
  pantoneCode  String?
  isRubberised Boolean             @default(false)
  qtyPerUnit   Float               @default(1)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  materials    ComponentMaterial[]
  Project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ProjectSku   ProjectSku?         @relation(fields: [skuId], references: [id])

  @@index([projectId])
  @@index([skuId])
  @@index([type])
}

model ComponentMaterial {
  id               String           @id @default(cuid())
  componentId      String
  materialId       String
  qtyPerComponent  Float
  unit             String
  stage            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ProductComponent ProductComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  Material         Material         @relation(fields: [materialId], references: [id])

  @@index([componentId])
  @@index([materialId])
}

model MoldMaster {
  id                  String           @id @default(cuid())
  code                String           @unique
  name                String
  cavities            Int              @default(1)
  cavityConfig        Json?
  cycleTimeSec        Int
  material            String
  productType         String?
  status              String           @default("active")
  location            String?
  manufacturer        String?
  purchaseDate        DateTime?
  maintenanceSchedule String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  machines            StationMachine[]

  @@index([material])
  @@index([status])
}

model StationMachine {
  id               String               @id @default(cuid())
  stationId        Int
  code             String               @unique
  name             String
  machineType      String
  moldMasterId     String?
  cycleTimeSec     Int?
  cavities         Int                  @default(1)
  status           String               @default("available")
  currentProjectId Int?
  currentSkuId     Int?
  location         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  changeovers      ChangeoverHistory[]
  allocations      ResourceAllocation[]
  MoldMaster       MoldMaster?          @relation(fields: [moldMasterId], references: [id])
  Station          Station              @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([status])
  @@index([currentProjectId])
}

model ResourceAllocation {
  id                String         @id @default(cuid())
  projectId         Int
  skuId             Int?
  stationId         Int
  machineId         String
  startDate         DateTime
  endDate           DateTime
  machinesAllocated Int            @default(1)
  status            String         @default("planned")
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdBy         String?
  StationMachine    StationMachine @relation(fields: [machineId], references: [id])
  Project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ProjectSku        ProjectSku?    @relation(fields: [skuId], references: [id])
  Station           Station        @relation(fields: [stationId], references: [id])

  @@index([projectId])
  @@index([stationId])
  @@index([machineId])
  @@index([startDate, endDate])
  @@index([status])
}

model ChangeoverHistory {
  id                String         @id @default(cuid())
  machineId         String
  fromProjectId     Int?
  fromSkuId         Int?
  toProjectId       Int
  toSkuId           Int?
  changeoverStart   DateTime
  changeoverEnd     DateTime?
  changeoverMinutes Int?
  rampUpEnd         DateTime?
  rampUpMinutes     Int?
  changeType        String
  notes             String?
  recordedBy        String?
  createdAt         DateTime       @default(now())
  FromProject       Project?       @relation("ChangeoverFromProject", fields: [fromProjectId], references: [id])
  FromSku           ProjectSku?    @relation("ChangeoverFromSku", fields: [fromSkuId], references: [id])
  StationMachine    StationMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  ToProject         Project        @relation("ChangeoverToProject", fields: [toProjectId], references: [id])
  ToSku             ProjectSku?    @relation("ChangeoverToSku", fields: [toSkuId], references: [id])

  @@index([machineId])
  @@index([fromSkuId, toSkuId])
  @@index([changeoverStart])
}

model DailyPlanGeneration {
  id                         String                     @id @default(cuid())
  projectId                  Int
  generatedAt                DateTime                   @default(now())
  generatedBy                String?
  status                     String                     @default("draft")
  approvedAt                 DateTime?
  approvedBy                 String?
  startDate                  DateTime
  endDate                    DateTime
  totalDays                  Int
  notes                      String?
  bottleneckOperation        String?
  effectiveCapacity          Int?
  planningStrategy           String                     @default("bottleneck")
  processFlowId              String?
  ProcessFlow                ProcessFlow?               @relation(fields: [processFlowId], references: [id])
  Project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stationPlans               DailyPlanStationAuto[]
  loadBalancingOpportunities LoadBalancingOpportunity[]
  adaptations                PlanAdaptation[]
  conflicts                  PlanConflict[]
  modificationHistory        PlanModificationHistory[]
  processDetails             ProcessPlanDetail[]

  @@index([projectId])
  @@index([processFlowId])
  @@index([status])
  @@index([startDate, endDate])
}

model ProcessPlanDetail {
  id                  String              @id @default(cuid())
  planId              String
  operationId         String
  date                DateTime            @db.Date
  sequence            Int
  inputCapacity       Int?
  operationCapacity   Int
  effectiveOutput     Int
  isBottleneck        Boolean             @default(false)
  stationId           Int?
  assignedMachines    Int                 @default(1)
  machineIds          Json?
  assignedWorkers     Int?
  capacityUtilization Float               @default(0)
  hoursRequired       Float?
  status              String              @default("planned")
  actualOutput        Int?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  ProcessOperation    ProcessOperation    @relation(fields: [operationId], references: [id])
  DailyPlanGeneration DailyPlanGeneration @relation(fields: [planId], references: [id], onDelete: Cascade)
  Station             Station?            @relation(fields: [stationId], references: [id])

  @@unique([planId, operationId, date])
  @@index([planId])
  @@index([date])
  @@index([operationId])
  @@index([status])
}

model PlanModificationHistory {
  id                  String              @id @default(cuid())
  planId              String
  detailId            String?
  changeType          String
  fieldChanged        String?
  oldValue            Json?
  newValue            Json?
  reason              String?
  impactAnalysis      Json?
  userId              String?
  createdAt           DateTime            @default(now())
  DailyPlanGeneration DailyPlanGeneration @relation(fields: [planId], references: [id], onDelete: Cascade)
  User                User?               @relation(fields: [userId], references: [id])

  @@index([planId])
  @@index([detailId])
  @@index([changeType])
  @@index([createdAt])
}

model PlanConflict {
  id                  String              @id @default(cuid())
  planId              String
  conflictType        String
  severity            String
  affectedDetails     Json
  description         String
  suggestion          String?
  resolved            Boolean             @default(false)
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionNote      String?
  createdAt           DateTime            @default(now())
  DailyPlanGeneration DailyPlanGeneration @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([conflictType])
  @@index([severity])
  @@index([resolved])
}

model DailyPlanStationAuto {
  id                  String              @id @default(cuid())
  planGenerationId    String
  projectId           Int
  skuId               Int
  stationId           Int
  date                DateTime
  targetQty           Int
  actualQty           Int                 @default(0)
  allocatedMachines   Int                 @default(1)
  theoreticalCapacity Int
  effectiveCapacity   Int
  changeoverMinutes   Int                 @default(0)
  status              String              @default("pending")
  blockedReason       String?
  completedAt         DateTime?
  variance            Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  DailyPlanGeneration DailyPlanGeneration @relation(fields: [planGenerationId], references: [id], onDelete: Cascade)
  Project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ProjectSku          ProjectSku          @relation(fields: [skuId], references: [id])
  Station             Station             @relation(fields: [stationId], references: [id])

  @@index([planGenerationId])
  @@index([projectId])
  @@index([skuId])
  @@index([stationId])
  @@index([date])
  @@index([status])
}

enum ReminderStatus {
  pending
  snoozed
  completed
  dismissed
}

enum QCItemType {
  boolean
  number
  text
  enum
  photo
  color
}

enum QCSeverity {
  INFO
  MINOR
  MAJOR
  CRITICAL
}

enum TaskPriority {
  Low
  Med
  High
}

enum TaskSection {
  Pre_Prod
  Production
  QC
  Dispatch
}

enum TaskStatus {
  green
  amber
  red
}
