  issuesNoted    String?
  photos         String[]
  handoverTime   DateTime  @default(now())
  Project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ShiftPlan      ShiftPlan @relation(fields: [shiftPlanId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([shiftPlanId])
}

model ShiftPlan {
  id               String          @id
  dailyPlanId      String
  shiftId          String
  workerId         String
  stationId        Int
  date             DateTime
  assignedBy       String?
  assignmentReason String?
  createdAt        DateTime        @default(now())
  ShiftHandover    ShiftHandover[]
  DailyPlan        DailyPlan       @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  Shift            Shift           @relation(fields: [shiftId], references: [id])
  Station          Station         @relation(fields: [stationId], references: [id])
  Worker           Worker          @relation(fields: [workerId], references: [id])

  @@index([dailyPlanId])
  @@index([date])
  @@index([stationId])
  @@index([workerId])
}

model StageDocument {
  id            String        @id
  stageId       String
  documentName  String
  documentUrl   String
  documentType  String?
  uploadedBy    String
  uploadedAt    DateTime      @default(now())
  WorkflowStage WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model StationType {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  code          String    @unique
  description   String?
  defaultSkills String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Station       Station[]

  @@index([code])
}

model StockMovement {
  id            String   @id
  materialId    String
  lotNumber     String?
  movementType  String
  qty           Float
  referenceType String?
  referenceId   String?
  notes         String?
  performedBy   String
  timestamp     DateTime @default(now())
  Material      Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([movementType])
  @@index([timestamp])
}

model BoardColumn {
  id         String      @id @default(cuid())
  projectId  Int
  name       String
  section    TaskSection
  position   Int         @default(0)
  wipLimit   Int?
  color      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  Project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, section])
  @@index([projectId])
  @@index([projectId, position])
}

model Task {
  id          String       @id
  projectId   Int?
  name        String
  section     TaskSection  @default(Pre_Prod)
  status      TaskStatus   @default(green)
  assignee    String?
  dueDate     DateTime?
  priority    TaskPriority @default(Med)
  tags        String[]
  attachments Int          @default(0)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Project     Project?     @relation(fields: [projectId], references: [id])
  Reminder    Reminder[]

  @@index([projectId])
  @@index([section, position])
}

model Reminder {
  id            String          @id @default(cuid())
  taskId        String?
  title         String
  description   String?
  dueAt         DateTime
  status        ReminderStatus  @default(pending)
  assignedToId  String?
  createdById   String
  snoozeUntil   DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  Task          Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignedTo    User?           @relation("AssignedReminders", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User            @relation("CreatedReminders", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status, dueAt])
}

enum ReminderStatus {
  pending
  snoozed
  completed
  dismissed
}

model ThirdPartyProvider {
  id                  String                @id
  name                String
  contactPerson       String?
  phone               String?
  email               String?
  location            String?
  contractStart       DateTime?
  contractEnd         DateTime?
  rateStructure       String?
  turnoverRate        Float?                @default(0)
  attendanceRate      Float?                @default(100)
  performanceScore    Float?                @default(0)
  consistencyRating   Float?                @default(0)
  stabilityScore      Float?                @default(0)
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Worker              Worker[]
  ProviderPerformance ProviderPerformance[]

  @@index([stabilityScore])
}

model ProviderPerformance {
  id                 String              @id
  providerId         String
  monthYear          String
  totalWorkers       Int                 @default(0)
  avgAttendance      Float               @default(0)
  stabilityScore     Float               @default(0)
  qualityScore       Float               @default(0)
  incidents          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  ThirdPartyProvider ThirdPartyProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([monthYear])
}

model Worker {
  id                 String              @id
  name               String
  employeeCode       String?             @unique
  email              String?
  phone              String?
  workerType         String
  providerId         String?
  skills             String[]
  certifications     Json?
  shiftPreference    String?
  hireDate           DateTime?
  contractEnd        DateTime?
  hourlyRate         Float?
  overtimeRate       Float?
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  ShiftPlan          ShiftPlan[]
  ThirdPartyProvider ThirdPartyProvider? @relation(fields: [providerId], references: [id])
  WorkerPerformance  WorkerPerformance[]

  @@index([providerId])
  @@index([status])
  @@index([workerType])
  @@index([employeeCode])
}

model WorkerPerformance {
  id              String   @id
  workerId        String
  projectId       Int
  stationId       Int
  date            DateTime
  shiftId         String
  shiftType       String?
  hoursWorked     Float?
  tasksCompleted  Int?
  targetQty       Int
  actualQty       Int
  rejectedQty     Int
  efficiency      Float
  qualityRate     Float
  completionTime  Int?
  createdAt       DateTime @default(now())
  Project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Station         Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  Worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([projectId])
  @@index([workerId])
}

model WorkflowDependency {
  id                                                          String        @id
  fromStageId                                                 String
  toStageId                                                   String
  dependencyType                                              String        @default("finish_to_start")
  lagDays                                                     Int           @default(0)
  createdAt                                                   DateTime      @default(now())
  WorkflowStage_WorkflowDependency_fromStageIdToWorkflowStage WorkflowStage @relation("WorkflowDependency_fromStageIdToWorkflowStage", fields: [fromStageId], references: [id], onDelete: Cascade)
  WorkflowStage_WorkflowDependency_toStageIdToWorkflowStage   WorkflowStage @relation("WorkflowDependency_toStageIdToWorkflowStage", fields: [toStageId], references: [id], onDelete: Cascade)

  @@index([fromStageId])
  @@index([toStageId])
}

model WorkflowStage {
  id                                                               String               @id
  projectId                                                        Int
  name                                                             String
  description                                                      String?
  sequence                                                         Int
  status                                                           String               @default("pending")
  estimatedDays                                                    Int?
  actualDays                                                       Int?
  requiresQC                                                       Boolean              @default(false)
  qcTemplateId                                                     String?
  requiresApproval                                                 Boolean              @default(false)
  approvalType                                                     String?
  startDate                                                        DateTime?
  endDate                                                          DateTime?
  createdAt                                                        DateTime             @default(now())
  updatedAt                                                        DateTime
  ApprovalRequest                                                  ApprovalRequest[]
  StageDocument                                                    StageDocument[]
  WorkflowDependency_WorkflowDependency_fromStageIdToWorkflowStage WorkflowDependency[] @relation("WorkflowDependency_fromStageIdToWorkflowStage")
  WorkflowDependency_WorkflowDependency_toStageIdToWorkflowStage   WorkflowDependency[] @relation("WorkflowDependency_toStageIdToWorkflowStage")
  Project                                                          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  QCChecklistTemplate                                              QCChecklistTemplate? @relation(fields: [qcTemplateId], references: [id])
  WorkflowTask                                                     WorkflowTask[]

  @@index([projectId])
  @@index([sequence])
  @@index([status])
}

model WorkflowTask {
  id            String        @id
  stageId       String
  name          String
  description   String?
  assignedTo    String?
  status        String        @default("pending")
  priority      String        @default("medium")
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  WorkflowStage WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@index([status])
}

enum QCItemType {
  boolean
  number
  text
  enum
  photo
  color
}

enum QCSeverity {
  INFO
  MINOR
  MAJOR
  CRITICAL
}

enum TaskPriority {
  Low
  Med
  High
}

enum TaskSection {
  Pre_Prod
  Production
  QC
  Dispatch
}

enum TaskStatus {
  green
  amber
  red
}

// ============================================================================
// PRE-PRODUCTION WORKFLOW MODELS
// ============================================================================

model Mold {
  id           String   @id @default(cuid())
  projectId    Int
  moldCode     String
  moldName     String
  supplierName String?
  cavities     Int      @default(1)
  material     String?
  dimensions   String?
  weight       Float?
  cost         Float?
  location     String?
  status       String   @default("designing") // designing, manufacturing, testing, approved, rejected, maintenance
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation("MoldCreator", fields: [createdBy], references: [id])
  trials  Trial[]

  @@unique([projectId, moldCode])
  @@index([projectId])
  @@index([status])
}

model Trial {
  id              String    @id @default(cuid())
  moldId          String
  projectId       Int
  trialNumber     Int
  trialDate       DateTime
  runBy           String
  machineId       String?
  cycleTime       Float?
  temperature     Float?
  pressure        Float?
  samplesProduced Int?
  defectsFound    Int?
  defectTypes     Json? // Array of {type, count, severity}
  observations    String?   @db.Text
  outcome         String    @default("pending") // pending, passed, failed, conditional
  approvedBy      String?
  approvedAt      DateTime?
  nextSteps       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mold     Mold    @relation(fields: [moldId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runner   User    @relation("TrialRunner", fields: [runBy], references: [id])
  approver User?   @relation("TrialApprover", fields: [approvedBy], references: [id])

  @@index([moldId])
  @@index([projectId])
  @@index([outcome])
}

model PackagingDesign {
  id             String    @id @default(cuid())
  projectId      Int
  designCode     String
  designName     String
  packagingType  String // box, blister, polybag, master_carton, display, etc.
  dimensions     String? // LxWxH in cm
  material       String?
  printingMethod String? // offset, flexo, digital, screen
  colors         Int?
  designFileUrl  String?
  mockupFileUrl  String?
  supplierName   String?
  unitCost       Float?
  moq            Int? // Minimum Order Quantity
  status         String    @default("concept") // concept, design, sampling, approved, rejected, production
  submittedBy    String
  submittedAt    DateTime  @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  feedback       String?   @db.Text
  revisionNumber Int       @default(1)
  parentDesignId String? // For tracking revisions
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitter    User              @relation("PackagingSubmitter", fields: [submittedBy], references: [id])
  reviewer     User?             @relation("PackagingReviewer", fields: [reviewedBy], references: [id])
  approver     User?             @relation("PackagingApprover", fields: [approvedBy], references: [id])
  parentDesign PackagingDesign?  @relation("PackagingRevisions", fields: [parentDesignId], references: [id], onDelete: SetNull)
  revisions    PackagingDesign[] @relation("PackagingRevisions")

  @@unique([projectId, designCode])
  @@index([projectId])
  @@index([status])
}

model PPSApproval {
  id              String    @id @default(cuid())
  projectId       Int
  ppsCode         String
  documentName    String
  documentUrl     String?
  version         String    @default("1.0")
  submittedBy     String
  submittedAt     DateTime  @default(now())
  reviewers       Json // Array of {userId, name, role, status, reviewedAt, comments}
  currentStage    String    @default("submission") // submission, technical_review, management_review, approved, rejected
  requiresChanges Boolean   @default(false)
  changeRequests  Json? // Array of {requestedBy, description, priority, addressedAt}
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text
  effectiveDate   DateTime?
  expiryDate      DateTime?
  status          String    @default("pending") // pending, in_review, changes_requested, approved, rejected, superseded
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitter User    @relation("PPSSubmitter", fields: [submittedBy], references: [id])
  approver  User?   @relation("PPSApprover", fields: [approvedBy], references: [id])
  rejector  User?   @relation("PPSRejector", fields: [rejectedBy], references: [id])

  @@unique([projectId, ppsCode])
  @@index([projectId])
  @@index([status])
  @@index([currentStage])
}

// ============================================================================
// COMPREHENSIVE COMPLIANCE SYSTEM
// ============================================================================

// Company-level certifications (SMETA, ISO, etc.)
model CompanyCertification {
  id                 String    @id @default(cuid())
  certificationType  String // smeta, iso9001, iso14001, bsci, wrap, etc.
  certificationName  String
  certificationBody  String // Audit company name
  certificateNumber  String?
  certificateFileUrl String?
  issueDate          DateTime
  expiryDate         DateTime
  lastAuditDate      DateTime?
  nextAuditDate      DateTime?
  auditScheduled     Boolean   @default(false)
  status             String    @default("active") // active, expiring_soon, expired, in_renewal, suspended
  scope              String?   @db.Text // What the certification covers
  responsiblePerson  String // User ID responsible for renewal
  reminderDays       Int       @default(90) // Days before expiry to send reminder
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  responsible User                 @relation("CompanyCertificationResponsible", fields: [responsiblePerson], references: [id])
  audits      ComplianceAudit[]
  reminders   ComplianceReminder[]

  @@unique([certificationType, certificateNumber])
  @@index([expiryDate])
  @@index([status])
  @@index([certificationType])
}

// Audit records for company certifications
model ComplianceAudit {
  id                String    @id @default(cuid())
  certificationId   String
  auditType         String // initial, surveillance, recertification, special
  auditDate         DateTime
  auditDuration     Int? // Days
  auditorName       String
  auditorCompany    String
  findings          Json? // Array of {type: 'major'|'minor'|'observation', description, status}
  correctiveActions Json? // Array of {findingId, action, dueDate, completedDate, evidence}
  auditReportUrl    String?
  outcome           String // passed, passed_with_conditions, failed
  nextAuditDate     DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  certification CompanyCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([certificationId])
  @@index([auditDate])
  @@index([outcome])
}

// Project-specific compliance requirements (GRS, ASTM, etc.)
model ProjectCompliance {
  id                String    @id @default(cuid())
  projectId         Int
  complianceType    String // grs, astm, reach, cpsia, oeko-tex, etc.
  complianceName    String
  required          Boolean   @default(true)
  status            String    @default("not_started") // not_started, in_progress, pending_certification, certified, failed, not_applicable
  priority          String    @default("medium") // low, medium, high, critical
  requiredBy        DateTime? // Deadline - when certification must be obtained
  certificationBody String? // Testing/certification authority
  responsiblePerson String // User ID responsible
  blocksProduction  Boolean   @default(false) // Can't start production without this
  blocksShipment    Boolean   @default(false) // Can't ship without this
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible  User                    @relation("ProjectComplianceResponsible", fields: [responsiblePerson], references: [id])
  requirements ComplianceRequirement[]
  documents    ComplianceDocument[]
  labTests     LabTest[]

  @@index([projectId])
  @@index([status])
  @@index([complianceType])
  @@index([responsiblePerson])
}

// Detailed requirements for each compliance (e.g., for GRS: all materials must be GRS certified)
model ComplianceRequirement {
  id                 String    @id @default(cuid())
  complianceId       String
  requirementType    String // material_certification, process_verification, facility_audit, test_report
  description        String    @db.Text
  isMandatory        Boolean   @default(true)
  verificationMethod String? // How to verify this requirement
  assignedTo         String? // User ID
  dueDate            DateTime?
  status             String    @default("pending") // pending, in_progress, completed, verified, failed
  completedAt        DateTime?
  completedBy        String?
  verificationNotes  String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  compliance ProjectCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  assignee   User?             @relation("RequirementAssignee", fields: [assignedTo], references: [id])
  completer  User?             @relation("RequirementCompleter", fields: [completedBy], references: [id])

  @@index([complianceId])
  @@index([status])
  @@index([assignedTo])
}

// Compliance documents (certificates, invoices, test reports)
model ComplianceDocument {
  id             String    @id @default(cuid())
  complianceId   String
  documentType   String // certificate, invoice, test_report, audit_report, coc, declaration
  documentName   String
  documentNumber String?
  fileUrl        String
  issueDate      DateTime
  expiryDate     DateTime?
  issuedBy       String? // Issuing authority/supplier
  relatedTo      String? // Material batch, supplier, etc.
  quantity       Float? // If it's for a specific quantity (e.g., invoice)
  quantityUnit   String?
  status         String    @default("active") // active, expired, superseded, invalid
  uploadedBy     String
  uploadedAt     DateTime  @default(now())
  verifiedBy     String?
  verifiedAt     DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  compliance ProjectCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  uploader   User              @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  verifier   User?             @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@index([complianceId])
  @@index([documentType])
  @@index([status])
  @@index([expiryDate])
}

// Lab test records for compliance
model LabTest {
  id                String    @id @default(cuid())
  projectId         Int
  complianceId      String? // Link to specific compliance requirement
  testType          String // astm, reach, cpsia, color_fastness, etc.
  testName          String
  labName           String
  labAccreditation  String? // ISO 17025, etc.
  sampleCode        String?
  sampleDescription String?
  testStandard      String? // e.g., ASTM F963, EN 71
  testDate          DateTime
  reportDate        DateTime?
  reportNumber      String?
  reportFileUrl     String?
  result            String // pass, fail, conditional, pending
  resultDetails     Json? // Array of {parameter, requirement, actualValue, result}
  retestRequired    Boolean   @default(false)
  retestDueDate     DateTime?
  cost              Float?
  costCurrency      String    @default("USD")
  notes             String?   @db.Text
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  compliance ProjectCompliance? @relation(fields: [complianceId], references: [id], onDelete: SetNull)
  creator    User               @relation("LabTestCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([complianceId])
  @@index([testType])
  @@index([result])
  @@index([testDate])
}

// Material compliance tracking (for GRS example: tracking GRS certificates of raw materials)
model MaterialCompliance {
  id                    String    @id @default(cuid())
  projectId             Int
  materialName          String
  materialType          String // fabric, thread, button, zipper, packaging, etc.
  supplierName          String
  complianceType        String // grs, oeko-tex, organic, recycled, etc.
  certificateNumber     String?
  certificateFileUrl    String?
  issueDate             DateTime?
  expiryDate            DateTime?
  purchaseInvoiceNumber String?
  purchaseInvoiceUrl    String?
  purchaseQuantity      Float?
  purchaseUnit          String?
  purchaseDate          DateTime?
  usedQuantity          Float?    @default(0)
  remainingQuantity     Float?
  traceable             Boolean   @default(false)
  traceabilityDocs      Json? // Array of document references
  status                String    @default("pending") // pending, verified, expired, insufficient
  verifiedBy            String?
  verifiedAt            DateTime?
  notes                 String?   @db.Text
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User    @relation("MaterialComplianceCreator", fields: [createdBy], references: [id])
  verifier User?   @relation("MaterialComplianceVerifier", fields: [verifiedBy], references: [id])

  @@index([projectId])
  @@index([complianceType])
  @@index([supplierName])
  @@index([status])
}

// Compliance reminders and alerts
model ComplianceReminder {
  id              String    @id @default(cuid())
  reminderType    String // certification_expiry, audit_due, test_due, document_expiry
  certificationId String? // For company certifications
  projectId       Int? // For project-specific compliance
  title           String
  description     String    @db.Text
  dueDate         DateTime
  priority        String    @default("medium") // low, medium, high, critical
  assignedTo      String // User ID
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  acknowledged    Boolean   @default(false)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  completed       Boolean   @default(false)
  completedAt     DateTime?
  snoozeUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  certification CompanyCertification? @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User                  @relation("ReminderAssignee", fields: [assignedTo], references: [id])
  acknowledger  User?                 @relation("ReminderAcknowledger", fields: [acknowledgedBy], references: [id])

  @@index([certificationId])
  @@index([projectId])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([completed])
}

// =====================================================
// PROJECT POLICY PACK
// =====================================================

model ProjectPolicy {
  id                  String    @id @default(cuid())
  projectId           Int
  policyType          String // quality, safety, environmental, social, compliance
  policyTitle         String
  policyDescription   String    @db.Text
  version             String    @default("1.0")
  effectiveDate       DateTime
  expiryDate          DateTime?
  status              String    @default("draft") // draft, active, inactive, superseded
  documentUrl         String?   @db.Text
  responsiblePerson   String // User ID
  reviewFrequency     Int? // In days
  lastReviewDate      DateTime?
  nextReviewDate      DateTime?
  applicableStations  Json? // Array of station IDs this policy applies to
  trainingRequired    Boolean   @default(false)
  trainingDocUrl      String?   @db.Text
  trainingCompletedBy Json? // Array of user IDs who completed training
  approvalHistory     Json? // Array of approval records
  notes               String?   @db.Text
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible User    @relation("PolicyResponsible", fields: [responsiblePerson], references: [id])
  creator     User    @relation("PolicyCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([policyType])
  @@index([status])
}

// =====================================================
// PROCESS FLOW BUILDER
// =====================================================

model ProcessFlow {
  id                String   @id @default(cuid())
  projectId         Int
  flowName          String
  flowDescription   String?  @db.Text
  version           String   @default("1.0")
  status            String   @default("draft") // draft, active, inactive
  isTemplate        Boolean  @default(false)
  totalOperations   Int      @default(0)
  estimatedDuration Int? // In minutes
  notes             String?  @db.Text
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator    User               @relation("ProcessFlowCreator", fields: [createdBy], references: [id])
  operations ProcessOperation[]

  @@index([projectId])
  @@index([status])
}

model ProcessOperation {
  id                   String   @id @default(cuid())
  processFlowId        String
  operationName        String
  operationCode        String
  operationDescription String?  @db.Text
  sequence             Int
  stationId            Int?
  machineRequired      String?
  skillLevel           String? // beginner, intermediate, advanced, expert
  estimatedTime        Int? // In minutes
  standardOutput       Int? // Units per hour
  qualityCheckpoints   Json? // Array of QC checkpoints
  safetyRequirements   Json? // Array of safety requirements
  toolsRequired        Json? // Array of tools/equipment
  predecessorIds       Json? // Array of operation IDs that must complete first
  isParallel           Boolean  @default(false)
  isCriticalPath       Boolean  @default(false)
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  processFlow   ProcessFlow    @relation(fields: [processFlowId], references: [id], onDelete: Cascade)
  station       Station?       @relation(fields: [stationId], references: [id])
  subOperations SubOperation[]

  @@index([processFlowId])
  @@index([stationId])
  @@index([sequence])
}

model SubOperation {
  id                 String   @id @default(cuid())
  processOperationId String
  subOperationName   String
  subOperationCode   String
  description        String?  @db.Text
  sequence           Int
  estimatedTime      Int? // In minutes
  isOptional         Boolean  @default(false)
  checkpoints        Json? // Array of verification points
  instructions       String?  @db.Text
  imageUrls          Json? // Array of reference images
  videoUrl           String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  processOperation ProcessOperation @relation(fields: [processOperationId], references: [id], onDelete: Cascade)

  @@index([processOperationId])
  @@index([sequence])
}

// =====================================================
// SHIFT ENTRY SYSTEM
// =====================================================

model ShiftEntry {
  id               String    @id @default(cuid())
  projectId        Int
  stationId        Int?
  shiftDate        DateTime
  shiftType        String // morning, afternoon, night, custom
  shiftStartTime   DateTime
  shiftEndTime     DateTime
  supervisorId     String
  workersPresent   Int       @default(0)
  workersAbsent    Int       @default(0)
  totalProduced    Int       @default(0)
  targetProduction Int?
  qualityPassed    Int       @default(0)
  qualityRejected  Int       @default(0)
  downtimeMinutes  Int       @default(0)
  downtimeReason   String?   @db.Text
  machineStatus    Json? // Array of machine statuses
  materialsUsed    Json? // Array of material consumption
  issues           Json? // Array of issues reported
  achievements     String?   @db.Text
  handoverNotes    String?   @db.Text
  efficiency       Float? // Calculated efficiency %
  status           String    @default("draft") // draft, submitted, approved
  approvedBy       String?
  approvedAt       DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  station    Station? @relation(fields: [stationId], references: [id])
  supervisor User     @relation("ShiftSupervisor", fields: [supervisorId], references: [id])
  approver   User?    @relation("ShiftApprover", fields: [approvedBy], references: [id])
  creator    User     @relation("ShiftCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([stationId])
  @@index([shiftDate])
  @@index([supervisorId])
  @@index([status])
}

// =====================================================
// WIP LEDGER SYSTEM
// =====================================================

model WIPLedger {
  id              String    @id @default(cuid())
  projectId       Int
  stationId       Int?
  batchId         String?
  transactionDate DateTime  @default(now())
  transactionType String // input, output, transfer, adjustment, scrap
  itemCode        String
  itemDescription String
  quantity        Float
  unit            String    @default("pcs")
  fromLocation    String?
  toLocation      String?
  fromStationId   Int?
  toStationId     Int?
  referenceType   String? // production_entry, qc_submission, batch_movement
  referenceId     String?
  operationCode   String?
  operatorId      String?
  qualityStatus   String? // pass, fail, pending, rework
  remarks         String?   @db.Text
  costPerUnit     Float?
  totalCost       Float?
  balanceQuantity Float? // Running balance after transaction
  status          String    @default("active") // active, cancelled, adjusted
  cancelledBy     String?
  cancelledAt     DateTime?
  cancelReason    String?   @db.Text
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  station     Station? @relation(fields: [stationId], references: [id])
  batch       Batch?   @relation(fields: [batchId], references: [id])
  fromStation Station? @relation("WIPFromStation", fields: [fromStationId], references: [id])
  toStation   Station? @relation("WIPToStation", fields: [toStationId], references: [id])
  operator    User?    @relation("WIPOperator", fields: [operatorId], references: [id])
  canceller   User?    @relation("WIPCanceller", fields: [cancelledBy], references: [id])
  creator     User     @relation("WIPCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([stationId])
  @@index([batchId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([itemCode])
  @@index([status])
}
