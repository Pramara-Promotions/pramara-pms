generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  passwordHash               String
  mfaSecret                  String?
  isActive                   Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  inviteToken                String?                   @unique
  inviteExpires              DateTime?
  departmentId               String?
  mfaEnforcedAt              DateTime?
  name                       String?
  status                     String                    @default("PENDING")
  trustDeviceDuration        Int                       @default(30)
  auditRetentionDays         Int                       @default(90)
  createdById                String?
  emailDigestEnabled         Boolean                   @default(true)
  emailDigestFrequency       String                    @default("daily")
  emailInboundEnabled        Boolean                   @default(false)
  emailOutboundEnabled       Boolean                   @default(false)
  emailOverrideSystem        Boolean                   @default(false)
  emailTrainingMode          Boolean                   @default(false)
  emailVerified              Boolean                   @default(false)
  firstName                  String?
  lastName                   String?
  mustChangePassword         Boolean                   @default(false)
  passwordResetAt            DateTime?
  passwordResetMethod        String?
  timeZone                   String?
  auditEvents                AuditLog[]                @relation("AuditByUser")
  companyCerts               CompanyCertification[]    @relation("CompanyCertificationResponsible")
  documentsUploaded          ComplianceDocument[]      @relation("DocumentUploader")
  documentsVerified          ComplianceDocument[]      @relation("DocumentVerifier")
  remindersAcknowledged      ComplianceReminder[]      @relation("ReminderAcknowledger")
  remindersAssigned          ComplianceReminder[]      @relation("ReminderAssignee")
  requirementsAssigned       ComplianceRequirement[]   @relation("RequirementAssignee")
  requirementsCompleted      ComplianceRequirement[]   @relation("RequirementCompleter")
  devices                    Device[]
  labTestsCreated            LabTest[]                 @relation("LabTestCreator")
  materialComplianceCreated  MaterialCompliance[]      @relation("MaterialComplianceCreator")
  materialComplianceVerified MaterialCompliance[]      @relation("MaterialComplianceVerifier")
  moldsCreated               Mold[]                    @relation("MoldCreator")
  notifications              Notification[]
  ppsApproved                PPSApproval[]             @relation("PPSApprover")
  ppsRejected                PPSApproval[]             @relation("PPSRejector")
  ppsSubmitted               PPSApproval[]             @relation("PPSSubmitter")
  packagingApproved          PackagingDesign[]         @relation("PackagingApprover")
  packagingReviewed          PackagingDesign[]         @relation("PackagingReviewer")
  packagingSubmitted         PackagingDesign[]         @relation("PackagingSubmitter")
  permissionRequests         PermissionRequest[]
  planModifications          PlanModificationHistory[]
  processFlowsCreated        ProcessFlow[]             @relation("ProcessFlowCreator")
  templatesCreated           ProcessTemplate[]         @relation("TemplateCreator")
  projectCompliance          ProjectCompliance[]       @relation("ProjectComplianceResponsible")
  policiesCreated            ProjectPolicy[]           @relation("PolicyCreator")
  policiesResponsible        ProjectPolicy[]           @relation("PolicyResponsible")
  assignedReminders          Reminder[]                @relation("AssignedReminders")
  createdReminders           Reminder[]                @relation("CreatedReminders")
  sessions                   Session[]
  shiftsApproved             ShiftEntry[]              @relation("ShiftApprover")
  shiftsCreated              ShiftEntry[]              @relation("ShiftCreator")
  shiftsSupervised           ShiftEntry[]              @relation("ShiftSupervisor")
  temporaryPermissions       TemporaryPermission[]
  trialsApproved             Trial[]                   @relation("TrialApprover")
  trialsRun                  Trial[]                   @relation("TrialRunner")
  User                       User?                     @relation("UserToUser", fields: [createdById], references: [id])
  other_User                 User[]                    @relation("UserToUser")
  department                 Department?               @relation(fields: [departmentId], references: [id])
  roles                      UserRole[]
  wipCancellations           WIPLedger[]               @relation("WIPCanceller")
  wipCreated                 WIPLedger[]               @relation("WIPCreator")
  wipOperations              WIPLedger[]               @relation("WIPOperator")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime         @default(now())
  createdBy   String?
  status      String           @default("ACTIVE")
  approvals   RoleApproval[]
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  deviceId         String?
  device           Device?  @relation(fields: [deviceId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model Device {
  id          String     @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  ip          String?
  userAgent   String?
  trusted     Boolean    @default(false)
  trustUntil  DateTime?
  lastUsedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  auditLogs   AuditLog[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([userId, fingerprint])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  changes   Json?
  deviceId  String?
  flagged   Boolean  @default(false)
  result    String?
  actor     User?    @relation("AuditByUser", fields: [actorId], references: [id])
  device    Device?  @relation(fields: [deviceId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([flagged])
  @@index([createdAt])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([name])
}

model TemporaryPermission {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  startDate      DateTime  @default(now())
  endDate        DateTime
  grantedBy      String
  reason         String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model PermissionRequest {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  reason         String
  duration       Int?
  status         String    @default("PENDING")
  requestedAt    DateTime  @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  response       String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RoleApproval {
  id         String    @id @default(cuid())
  roleId     String
  createdBy  String
  status     String    @default("PENDING")
  reviewedBy String?
  reviewedAt DateTime?
  feedback   String?
  createdAt  DateTime  @default(now())
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              String
  title             String
  message           String
  read              Boolean   @default(false)
  createdAt         DateTime  @default(now())
  assignedTo        String?
  dismissed         Boolean   @default(false)
  dismissedAt       DateTime?
  entityCode        String?
  entityId          String?
  entityName        String?
  entityType        String?
  expiresAt         DateTime?
  impactDetails     Json?
  impactLevel       String?
  location          String?
  primaryAction     String?
  primaryActionType String?
  primaryActionUrl  String?
  priority          String    @default("medium")
  readAt            DateTime?
  secondaryActions  Json?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([priority])
  @@index([expiresAt])
  @@index([type])
  @@index([userId, dismissed])
  @@index([entityType, entityId])
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  pinnedItems   Json     @default("[]")
  homeLayout    Json?
  theme         String   @default("light")
  notifications Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Project {
  id                    Int                     @id @default(autoincrement())
  code                  String
  name                  String
  sku                   String?
  quantity              Int
  cutoffDate            DateTime?
  pantoneCode           String?
  createdAt             DateTime                @default(now())
  alerts                Alert[]
  alertRules            AlertRule[]
  ApprovalRequest       ApprovalRequest[]
  Batch                 Batch[]
  BoardColumn           BoardColumn[]
  changes               ChangeLog[]
  changeoversFrom       ChangeoverHistory[]     @relation("ChangeoverFromProject")
  changeoversTo         ChangeoverHistory[]     @relation("ChangeoverToProject")
  complianceItems       ComplianceItem[]
  complianceReminders   ComplianceReminder[]
  DailyPlan             DailyPlan[]
  dailyPlanGenerations  DailyPlanGeneration[]
  DailyPlanStation      DailyPlanStation[]
  dailyPlanStationsAuto DailyPlanStationAuto[]
  inventoryNeeds        InventoryNeed[]
  labTests              LabTest[]
  Lots                  Lot[]
  mrpLearning           MRPLearning[]
  mrpRecommendations    MRPRecommendation[]
  materialCompliance    MaterialCompliance[]
  MaterialConsumption   MaterialConsumption[]
  materialRequirements  MaterialRequirement[]
  molds                 Mold[]
  ppsApprovals          PPSApproval[]
  packagingDesigns      PackagingDesign[]
  planAdaptations       PlanAdaptation[]
  preProdSteps          PreProdStep[]
  ProcessConfig         ProcessConfig[]
  processFlows          ProcessFlow[]
  components            ProductComponent[]
  ProductionCalculation ProductionCalculation[]
  ProductionEntry       ProductionEntry[]
  projectCompliance     ProjectCompliance[]
  costings              ProjectCosting[]
  documents             ProjectDocument[]
  policies              ProjectPolicy[]
  pref                  ProjectPref?
  skus                  ProjectSku[]
  workflowStatus        ProjectWorkflowStatus?
  purchaseOrders        PurchaseOrder[]
  QCChecklistTemplate   QCChecklistTemplate[]
  qcRecords             QCRecord[]
  QCSubmission          QCSubmission[]
  resourceAllocations   ResourceAllocation[]
  shiftEntries          ShiftEntry[]
  ShiftHandover         ShiftHandover[]
  stations              Station[]
  Task                  Task[]
  trials                Trial[]
  variances             VarianceItem[]
  wipLedgers            WIPLedger[]
  WorkerPerformance     WorkerPerformance[]
  WorkflowStage         WorkflowStage[]
}

model ProjectWorkflowStatus {
  id                        String    @id @default(cuid())
  projectId                 Int       @unique
  processFlowComplete       Boolean   @default(false)
  processFlowCompletedAt    DateTime?
  processFlowOperationCount Int       @default(0)
  bomComplete               Boolean   @default(false)
  bomCompletedAt            DateTime?
  bomComponentCount         Int       @default(0)
  moldsAssigned             Boolean   @default(false)
  moldsAssignedAt           DateTime?
  moldCount                 Int       @default(0)
  trialsComplete            Boolean   @default(false)
  trialsCompletedAt         DateTime?
  approvedTrialCount        Int       @default(0)
  costingComplete           Boolean   @default(false)
  costingCompletedAt        DateTime?
  finalCostPerUnit          Float?
  marginPercent             Float?
  poReceived                Boolean   @default(false)
  poReceivedAt              DateTime?
  poNumber                  String?
  poQuantity                Int?
  poCutoffDate              DateTime?
  canPlan                   Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  Project                   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([canPlan])
  @@index([projectId])
}

model ProjectPref {
  id          Int     @id @default(autoincrement())
  projectId   Int     @unique
  skuAttrKeys Json?
  lastPo      String?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id        Int      @id @default(autoincrement())
  projectId Int
  poNumber  String
  fileKey   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, poNumber])
  @@index([projectId])
}

model ProjectSku {
  id                    Int                    @id @default(autoincrement())
  projectId             Int
  code                  String
  attributes            Json?
  color                 String?
  name                  String?
  orderQty              Int?
  poNumber              String?
  type                  String?
  bomItems              BOMItem[]
  Batch                 Batch[]
  changeoversFrom       ChangeoverHistory[]    @relation("ChangeoverFromSku")
  changeoversTo         ChangeoverHistory[]    @relation("ChangeoverToSku")
  DailyPlanStation      DailyPlanStation[]
  dailyPlanStationsAuto DailyPlanStationAuto[]
  mrpLearning           MRPLearning[]
  mrpRecommendations    MRPRecommendation[]
  materialRequirements  MaterialRequirement[]
  ProcessConfig         ProcessConfig[]
  components            ProductComponent[]
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  QCChecklistTemplate   QCChecklistTemplate[]
  QCSubmission          QCSubmission[]
  resourceAllocations   ResourceAllocation[]

  @@unique([projectId, code])
  @@index([projectId])
}

model ComplianceItem {
  id          Int       @id @default(autoincrement())
  projectId   Int
  type        String
  status      String    @default("PLANNED")
  owner       String?
  labName     String?
  dueDate     DateTime?
  requestedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  documentUrl String?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([type])
}

model ChangeLog {
  id               Int               @id @default(autoincrement())
  projectId        Int
  type             String
  description      String?
  requestedBy      String
  requestedAt      DateTime          @default(now())
  impact           Json?
  approvalRequired Boolean           @default(true)
  approver         String?
  approvedBy       String?
  approvalStatus   String            @default("PENDING")
  approvalProof    String?
  approvalDate     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents        ProjectDocument[]

  @@index([projectId])
  @@index([approvalStatus])
  @@index([type])
}

model ProjectDocument {
  id                 Int               @id @default(autoincrement())
  projectId          Int
  url                String?
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  approvalProof      String?
  contentType        String?
  storageKey         String?
  active             Boolean           @default(false)
  affectedTeams      Json?
  approvedAt         DateTime?
  approvedBy         String?
  approverRole       String?
  isStandard         Boolean           @default(false)
  kind               String
  notes              String?
  sourceChangeId     Int?
  tags               Json?
  title              String
  updatedAt          DateTime          @updatedAt
  uploadedAt         DateTime          @default(now())
  uploadedBy         String?
  verificationProof  String?
  verifiedAt         DateTime?
  verifiedBy         String?
  verifierRole       String?
  key                String?
  approvalEmails     Json?
  notificationEmails Json?
  referenceUrl       String?
  parentId           Int?
  revisionNote       String?
  documentStations   DocumentStation[]
  parent             ProjectDocument?  @relation("DocumentParent", fields: [parentId], references: [id])
  revisions          ProjectDocument[] @relation("DocumentParent")
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeLog          ChangeLog?        @relation(fields: [sourceChangeId], references: [id])
  variances          VarianceItem[]    @relation("VarianceDocument")

  @@index([projectId, kind, title])
  @@index([parentId])
}

model Station {
  id                                                 Int                     @id @default(autoincrement())
  projectId                                          Int?
  name                                               String
  active                                             Boolean                 @default(true)
  avgOutputRate                                      Float?
  avgQualityRate                                     Float?
  capacity                                           Int?                    @default(1)
  code                                               String?                 @unique
  createdAt                                          DateTime                @default(now())
  description                                        String?
  roomId                                             Int?
  stationTypeId                                      Int?
  status                                             String                  @default("operational")
  totalJobsCompleted                                 Int                     @default(0)
  updatedAt                                          DateTime
  actualCycleTime                                    Float?
  actualUtilization                                  Float?
  baseCycleTime                                      Float?
  currentSKU                                         String?
  cycleTimeUnit                                      String?
  isMultiAsset                                       Boolean                 @default(false)
  learningEnabled                                    Boolean                 @default(true)
  performanceBaseline                                Json?
  requiredAssetTypes                                 String[]
  requiresAssets                                     Boolean                 @default(false)
  skuCycleTimeMap                                    Json?
  targetUtilization                                  Float?
  workstationType                                    String?
  Batch                                              Batch[]
  BatchMovement_BatchMovement_fromStationIdToStation BatchMovement[]         @relation("BatchMovement_fromStationIdToStation")
  BatchMovement_BatchMovement_toStationIdToStation   BatchMovement[]         @relation("BatchMovement_toStationIdToStation")
  DailyPlanStation                                   DailyPlanStation[]
  dailyPlanStationsAuto                              DailyPlanStationAuto[]
  documents                                          DocumentStation[]
  MaintenanceLog                                     MaintenanceLog[]
  MaterialConsumption                                MaterialConsumption[]
  ProcessConfig                                      ProcessConfig[]
  processOperations                                  ProcessOperation[]
  processPlanDetails                                 ProcessPlanDetail[]
  ProductionCalculation                              ProductionCalculation[]
  ProductionEntry                                    ProductionEntry[]
  QCChecklistTemplate                                QCChecklistTemplate[]
  QCSubmission                                       QCSubmission[]
  resourceAllocations                                ResourceAllocation[]
  shiftEntries                                       ShiftEntry[]
  ShiftPlan                                          ShiftPlan[]
  project                                            Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Room                                               Room?                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  StationType                                        StationType?            @relation(fields: [stationTypeId], references: [id])
  machines                                           StationMachine[]
  wipFromStation                                     WIPLedger[]             @relation("WIPFromStation")
  wipLedgers                                         WIPLedger[]
  wipToStation                                       WIPLedger[]             @relation("WIPToStation")
  WorkerPerformance                                  WorkerPerformance[]
  WorkstationAssets                                  WorkstationAsset[]      @relation("StationAssets")

  @@index([code])
  @@index([projectId])
  @@index([roomId])
  @@index([stationTypeId])
  @@index([status])
  @@index([workstationType])
}

model DocumentStation {
  id         Int             @id @default(autoincrement())
  documentId Int
  stationId  Int
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  station    Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([documentId, stationId])
}

model VarianceItem {
  id          Int              @id @default(autoincrement())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  actual      String
  category    String
  expected    String
  field       String
  projectId   Int
  remarks     String?
  resolvedAt  DateTime?
  sourceDocId Int?
  status      String           @default("DEVIATION")
  Project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      ProjectDocument? @relation("VarianceDocument", fields: [sourceDocId], references: [id])

  @@index([projectId])
}

model QCRecord {
  id           Int      @id @default(autoincrement())
  projectId    Int
  createdAt    DateTime @default(now())
  batchCode    String?
  pantoneMatch String?  @default("Match")
  passed       Int      @default(0)
  reason       String?
  rejected     Int      @default(0)
  Project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model InventoryNeed {
  id           Int      @id @default(autoincrement())
  projectId    Int
  createdAt    DateTime @default(now())
  availableQty Int
  material     String
  requiredQty  Int
  shortfall    Int      @default(0)
  updatedAt    DateTime @updatedAt
  Project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AlertRule {
  id         Int      @id @default(autoincrement())
  projectId  Int
  createdAt  DateTime @default(now())
  enabled    Boolean  @default(true)
  key        String
  level      String
  recipients String?
  threshold  Int      @default(0)
  updatedAt  DateTime @updatedAt
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, key])
}

model Alert {
  id        Int           @id @default(autoincrement())
  projectId Int
  message   String
  createdAt DateTime      @default(now())
  level     String
  status    String        @default("OPEN")
  updatedAt DateTime      @updatedAt
  Project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions   AlertAction[]

  @@index([projectId])
  @@index([status])
}

model AlertAction {
  id                Int      @id @default(autoincrement())
  alertId           Int
  action            String
  createdAt         DateTime @default(now())
  by                String?
  correctiveActions String?
  costImpactCents   Int?
  costNote          String?
  note              String?
  preventRecurrence String?
  alert             Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model PreProdStep {
  id        Int       @id @default(autoincrement())
  projectId Int
  step      String
  status    String
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  Project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApprovalReminder {
  id                String          @id
  approvalRequestId String
  reminderType      String
  reminderDate      DateTime
  sentAt            DateTime?
  sentTo            String[]
  channel           String
  status            String          @default("pending")
  ApprovalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@index([reminderDate])
  @@index([status])
}

model ApprovalRequest {
  id                  String             @id
  projectId           Int
  workflowStageId     String?
  approvalType        String
  description         String
  requiredFrom        String
  requiredFromContact String?
  requestedBy         String
  requestedAt         DateTime           @default(now())
  expectedDate        DateTime
  cutoffDate          DateTime
  bufferDays          Int
  status              String             @default("pending")
  approvedAt          DateTime?
  approvedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  requestedChanges    String?
  delayedNewDate      DateTime?
  delayReason         String?
  overrideBy          String?
  overrideReason      String?
  overrideRisk        String?
  overrideAt          DateTime?
  attachments         String[]
  ApprovalReminder    ApprovalReminder[]
  Project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  WorkflowStage       WorkflowStage?     @relation(fields: [workflowStageId], references: [id])

  @@index([cutoffDate])
  @@index([projectId])
  @@index([status])
}

model Batch {
  id                 String          @id
  batchCode          String          @unique
  projectId          Int
  poNumber           String?
  projectSkuId       Int
  targetQty          Int
  currentQty         Int
  rejectedQty        Int             @default(0)
  currentStationId   Int?
  status             String          @default("in_progress")
  materialLots       Json
  machineId          String?
  createdBy          String
  createdAt          DateTime        @default(now())
  completedAt        DateTime?
  assembledFrom      String[]
  assembledInto      String?
  assemblyDate       DateTime?
  assemblyOperator   String?
  assemblyStation    String?
  calculatedQty      Int?
  containerWeight    Float?
  isRejection        Boolean         @default(false)
  lotId              String?
  parentBatchId      String?
  quantityMethod     String          @default("count")
  rejectionReason    String?
  rejectionStationId Int?
  reworkCompleted    Boolean         @default(false)
  reworkRequired     Boolean         @default(false)
  subBatchIdentifier String?
  subSkuIdentifier   String?
  totalWeight        Float?
  Station            Station?        @relation(fields: [currentStationId], references: [id])
  Lot                Lot?            @relation(fields: [lotId], references: [id])
  ParentBatch        Batch?          @relation("SubBatches", fields: [parentBatchId], references: [id], onUpdate: NoAction)
  SubBatches         Batch[]         @relation("SubBatches")
  Project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
