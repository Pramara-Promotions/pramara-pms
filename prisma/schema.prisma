// Asset Management System
model Asset {
  id        String  @id @default(cuid())
  assetCode String  @unique
  assetName String
  assetType String // 'machine', 'tool', 'equipment', 'fixture'
  category  String? // More specific categorization

  // Specifications
  manufacturer   String?
  model          String?
  specifications Json? // Detailed specs (capacity, power, dimensions, etc.)

  // Mobility & Location
  mobility          String  @default("fixed") // 'fixed', 'movable'
  currentLocation   String?
  assignedToStation String? // Current workstation if assigned

  // Status & Condition
  status    String @default("available") // 'available', 'in_use', 'maintenance', 'retired'
  condition String @default("good") // 'excellent', 'good', 'fair', 'poor'

  // Maintenance
  lastMaintenanceDate     DateTime?
  nextMaintenanceDate     DateTime?
  maintenanceHistory      Json? // Array of maintenance records
  maintenanceIntervalDays Int? // Preventive maintenance interval

  // Performance Tracking
  totalRunHours   Float     @default(0)
  totalCycles     Int       @default(0)
  lastUsedDate    DateTime?
  utilizationRate Float? // Percentage utilization

  // Cost Information
  purchaseDate     DateTime?
  purchaseCost     Float?
  depreciationRate Float?

  // Documentation
  manualUrl String?
  images    String[] // Array of image URLs
  notes     String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  WorkstationAssets WorkstationAsset[] // Many-to-many with workstations

  @@index([assetCode])
  @@index([assetType])
  @@index([status])
  @@index([mobility])
}

// Junction table for Workstation-Asset many-to-many relationship
model WorkstationAsset {
  id            String @id @default(cuid())
  workstationId Int // References Station.id (workstation)
  assetId       String

  // Assignment Details
  assignedAt DateTime  @default(now())
  assignedBy String?
  removedAt  DateTime?
  removedBy  String?

  // Configuration
  isPrimary  Boolean @default(false) // Is this the primary/main asset for this workstation?
  isRequired Boolean @default(true) // Is this asset required for workstation operation?

  // Performance at this workstation
  cycleTimeImpact  Float? // How this asset affects cycle time (multiplier)
  efficiencyImpact Float? // How this asset affects efficiency (%)

  // Notes
  notes String?

  // Relations
  Workstation Station @relation("StationAssets", fields: [workstationId], references: [id], onDelete: Cascade)
  Asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([workstationId, assetId, assignedAt])
  @@index([workstationId])
  @@index([assetId])
}

