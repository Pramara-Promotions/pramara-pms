// prisma/schema.prisma
// ====================================================================
// [LANDMARK A] GENERATOR & DATASOURCE
// ====================================================================
generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// [LANDMARK B] AUTH & SECURITY MODELS
// ====================================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  mfaSecret    String?
  mfaEnforcedAt DateTime?
  isActive     Boolean  @default(true)
  status       String   @default("PENDING") // PENDING, ACTIVE, INACTIVE, SUSPENDED
  departmentId String?
  trustDeviceDuration Int @default(30) // days
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department  Department? @relation(fields: [departmentId], references: [id])
  roles       UserRole[]
  sessions    Session[]
  devices     Device[]
  auditEvents AuditLog[] @relation("AuditByUser")
  temporaryPermissions TemporaryPermission[]
  permissionRequests PermissionRequest[]
  notifications Notification[]

  // Invites
  inviteToken   String?   @unique
  inviteExpires DateTime?
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  status      String           @default("ACTIVE") // ACTIVE, PENDING_APPROVAL
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
  approvals   RoleApproval[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  // back-relation for RolePermission
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ip               String?
  deviceId         String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  ip          String?
  userAgent   String?
  trusted     Boolean   @default(false)
  trustUntil  DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
  auditLogs AuditLog[]

  @@unique([userId, fingerprint])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  deviceId  String?
  changes   Json?
  result    String?  // SUCCESS, FAILURE
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  actor  User?   @relation("AuditByUser", fields: [actorId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([flagged])
  @@index([createdAt])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([name])
}

model TemporaryPermission {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  startDate      DateTime  @default(now())
  endDate        DateTime
  grantedBy      String
  reason         String?
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model PermissionRequest {
  id             String    @id @default(cuid())
  userId         String
  permissionCode String
  reason         String
  duration       Int?      // days, null = permanent
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt    DateTime  @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  response       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RoleApproval {
  id         String    @id @default(cuid())
  roleId     String
  createdBy  String
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  feedback   String?
  createdAt  DateTime  @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ====================================================================
// [LANDMARK C] PROJECT & EXECUTION MODELS
// ====================================================================
model Project {
  id          Int       @id @default(autoincrement())
  code        String
  name        String
  sku         String?
  quantity    Int
  cutoffDate  DateTime?
  pantoneCode String?
  createdAt   DateTime  @default(now())

  // Relations
  complianceItems ComplianceItem[]
  changes         ChangeLog[]
  documents       ProjectDocument[]
  skus            ProjectSku[]
  qcRecords       QCRecord[]
  alerts          Alert[]
  alertRules      AlertRule[]
  inventoryNeeds  InventoryNeed[]
  preProdSteps    PreProdStep[]
  variances       VarianceItem[]

  stations        Station[]

  pref           ProjectPref?
  purchaseOrders PurchaseOrder[]
}

// [LMK: PRISMA — CASCADE CHILDREN WHEN PROJECT DELETES]
// (Prisma does NOT support /* */ comments; use // only.)

model ProjectPref {
  id          Int     @id @default(autoincrement())
  projectId   Int     @unique
  skuAttrKeys Json?
  lastPo      String?
  // [LMK] cascade when a project is deleted
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  projectId  Int
  poNumber   String
  fileKey    String
  createdAt  DateTime @default(now())
  // [LMK] cascade when a project is deleted
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, poNumber])
  @@index([projectId])
}

model ProjectSku {
  id         Int      @id @default(autoincrement())
  projectId  Int
  poNumber   String?
  code       String
  name       String?
  color      String?
  type       String?
  orderQty   Int?
  attributes Json?
  // [LMK] cascade when a project is deleted
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, code])
}

model ComplianceItem {
  id          Int       @id @default(autoincrement())
  projectId   Int
  type        String
  status      String    @default("PLANNED")
  owner       String?
  labName     String?
  dueDate     DateTime?
  requestedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  documentUrl String?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([type])
}

model ChangeLog {
  id          Int               @id @default(autoincrement())
  projectId   Int
  type        String
  description String?
  requestedBy String
  requestedAt DateTime          @default(now())
  impact      Json?
  documents   ProjectDocument[]

  approvalRequired Boolean   @default(true)
  approver         String?
  approvedBy       String?
  approvalStatus   String    @default("PENDING")
  approvalProof    String?
  approvalDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approvalStatus])
  @@index([type])
}

model ProjectDocument {
  id                Int       @id @default(autoincrement())
  projectId         Int
  kind              String
  title             String
  url               String?
  referenceUrl      String?
  key               String?
  storageKey        String?
  contentType       String?
  version           Int       @default(1)
  active            Boolean   @default(false)
  tags              Json?
  notes             String?
  uploadedBy        String?
  uploadedAt        DateTime  @default(now())
  approvedBy        String?
  approverRole      String?
  approvedAt        DateTime?
  approvalProof     String?
  verifiedBy        String?
  verifierRole      String?
  verifiedAt        DateTime?
  verificationProof String?
  affectedTeams     Json?
  isStandard        Boolean   @default(false)
  sourceChangeId    Int?
  approvalEmails    Json?
  notificationEmails Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Versioning
  parentId          Int?
  parent            ProjectDocument? @relation("DocumentParent", fields: [parentId], references: [id])
  revisions         ProjectDocument[] @relation("DocumentParent")
  revisionNote      String?

  // Tagging to stations
  documentStations  DocumentStation[]

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeLog ChangeLog?     @relation(fields: [sourceChangeId], references: [id])
  variances VarianceItem[] @relation("VarianceDocument")

  @@index([projectId, kind, title])
  @@index([parentId])
}

// Station model (if not already present)
model Station {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  // ... add more fields as needed
  documents DocumentStation[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Join table for many-to-many between ProjectDocument and Station
model DocumentStation {
  id           Int             @id @default(autoincrement())
  documentId   Int
  stationId    Int
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  station      Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([documentId, stationId])
}

model VarianceItem {
  id          Int       @id @default(autoincrement())
  projectId   Int
  category    String
  field       String
  expected    String
  actual      String
  sourceDocId Int?
  remarks     String?
  status      String    @default("DEVIATION")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  ProjectDocument? @relation("VarianceDocument", fields: [sourceDocId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model QCRecord {
  id           Int      @id @default(autoincrement())
  projectId    Int
  batchCode    String?
  passed       Int      @default(0)
  rejected     Int      @default(0)
  reason       String?
  pantoneMatch String?  @default("Match")
  createdAt    DateTime @default(now())

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model InventoryNeed {
  id           Int      @id @default(autoincrement())
  projectId    Int
  material     String
  requiredQty  Int
  availableQty Int
  shortfall    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AlertRule {
  id         Int      @id @default(autoincrement())
  projectId  Int
  key        String
  level      String
  threshold  Int      @default(0)
  recipients String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, key])
}

model Alert {
  id        Int      @id @default(autoincrement())
  projectId Int
  level     String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions AlertAction[]

  @@index([projectId])
  @@index([status])
}

model AlertAction {
  id                Int      @id @default(autoincrement())
  alertId           Int
  action            String
  by                String?
  note              String?
  correctiveActions String?
  preventRecurrence String?
  costImpactCents   Int?
  costNote          String?
  createdAt         DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model PreProdStep {
  id        Int       @id @default(autoincrement())
  projectId Int
  step      String
  status    String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  Project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
